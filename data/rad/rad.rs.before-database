#[derive(Clone, Copy, Debug, PartialEq)]
enum RadTruth {
    Yes,
    No,
    Unknown,
}
impl RadTruth {
    fn not(self) -> Self {
        match self {
            Self::Yes => Self::No,
            Self::No => Self::Yes,
            _ => Self::Unknown,
        }
    }
    fn and(self, other: Self) -> Self {
        if self == Self::No || other == Self::No {
            Self::No
        } else if self == Self::Yes && other == Self::Yes {
            Self::Yes
        } else {
            Self::Unknown
        }
    }
    fn or(self, other: Self) -> Self {
        if self == Self::Yes || other == Self::Yes {
            Self::Yes
        } else if self == Self::No && other == Self::No {
            Self::No
        } else {
            Self::Unknown
        }
    }
}

fn rad_str<'a>(v: &'a RadValue, key: &str) -> &'a str {
    v[key].as_str().unwrap_or("")
}
fn rad_values(v: &RadValue) -> Vec<&str> {
    v["values"]
        .as_array()
        .map(|a| a.iter().filter_map(RadValue::as_str).collect())
        .unwrap_or_default()
}
fn rad_expression_refs(node: &RadValue, refs: &mut Vec<String>) {
    if matches!(rad_str(node, "op"), "via" | "sequence" | "direct") {
        refs.extend(rad_values(node).iter().map(|s| s.to_string()));
    }
    for arg in node["args"].as_array().into_iter().flatten() {
        rad_expression_refs(arg, refs);
    }
    for key in ["from", "to", "area", "location", "condition"] {
        if let Some(arg) = node.get(key) {
            rad_expression_refs(arg, refs);
        }
    }
    if rad_str(node, "op") == "route" {
        refs.extend(
            node["parts"]
                .as_array()
                .into_iter()
                .flatten()
                .flat_map(|p| p.as_array().into_iter().flatten())
                .filter_map(RadValue::as_str)
                .filter(|s| *s != "DCT")
                .map(str::to_string),
        );
    }
}
fn rad_near_name(a: &str, b: &str) -> bool {
    if a.len().abs_diff(b.len()) > 1
        || a.chars().filter(char::is_ascii_digit).collect::<String>()
            != b.chars().filter(char::is_ascii_digit).collect::<String>()
    {
        return false;
    }
    if a.len() < 4 || b.len() < 4 || a[..2] != b[..2] {
        return false;
    }
    let aa = a.as_bytes();
    let bb = b.as_bytes();
    let (mut i, mut j, mut errors) = (0, 0, 0);
    while i < aa.len() && j < bb.len() {
        if aa[i] == bb[j] {
            i += 1;
            j += 1;
        } else {
            errors += 1;
            if errors > 1 {
                return false;
            }
            if aa.len() >= bb.len() {
                i += 1;
            }
            if bb.len() >= aa.len() {
                j += 1;
            }
        }
    }
    errors + usize::from(i < aa.len() || j < bb.len()) <= 1
}
fn area_name(value: &str) -> String {
    let compact: String = value
        .to_ascii_uppercase()
        .chars()
        .filter(|c| c.is_ascii_alphanumeric())
        .collect();
    // Remove only presentation zeros before an area's numeric identifier.
    let mut out = String::new();
    let chars = compact.chars().collect::<Vec<_>>();
    let mut i = 0;
    while i < chars.len() {
        if chars[i].is_ascii_digit() {
            let start = i;
            while i < chars.len() && chars[i].is_ascii_digit() {
                i += 1;
            }
            let digits: String = chars[start..i].iter().collect();
            let digits = digits.trim_start_matches('0');
            out.push_str(if digits.is_empty() { "0" } else { digits });
        } else {
            out.push(chars[i]);
            i += 1;
        }
    }
    out
}

fn parse_special_areas(data: &RadValue) -> Result<Vec<SpecialArea>, String> {
    let records = data
        .as_array()
        .ok_or("IVAO special areas response is not an array")?;
    let mut areas = Vec::new();
    for raw in records {
        let id = raw["id"]
            .as_str()
            .map(str::to_string)
            .or_else(|| raw["id"].as_u64().map(|n| n.to_string()))
            .ok_or("Area without ID")?;
        let name = rad_str(raw, "name").to_string();
        let polygon = raw["regionMap"]
            .as_array()
            .map(|p| {
                p.iter()
                    .filter_map(|v| {
                        Some(Point {
                            lat: v["lat"].as_f64()?,
                            lon: v["lng"].as_f64()?,
                        })
                    })
                    .collect::<Vec<_>>()
            })
            .unwrap_or_default();
        let polygon = if polygon.is_empty() {
            raw["regionMapPolygon"]
                .as_array()
                .map(|p| {
                    p.iter()
                        .filter_map(|v| {
                            Some(Point {
                                lat: v[1].as_f64()?,
                                lon: v[0].as_f64()?,
                            })
                        })
                        .collect()
                })
                .unwrap_or_default()
        } else {
            polygon
        };
        if polygon.len() < 3
            || polygon.iter().any(|p| {
                !p.lat.is_finite() || !p.lon.is_finite() || p.lat.abs() > 90. || p.lon.abs() > 180.
            })
        {
            continue;
        }
        let bounds = polygon.iter().fold(
            [
                f64::INFINITY,
                f64::INFINITY,
                f64::NEG_INFINITY,
                f64::NEG_INFINITY,
            ],
            |b, p| {
                [
                    b[0].min(p.lon),
                    b[1].min(p.lat),
                    b[2].max(p.lon),
                    b[3].max(p.lat),
                ]
            },
        );
        let mut names = BTreeSet::from([area_name(&name)]);
        // Leading designators are reliable; description substrings are not aliases.
        if let Some(first) = name.split_whitespace().next() {
            let normalized = area_name(first);
            names.insert(normalized.clone());
            if ["D", "R", "P", "TRA", "TSA"].iter().any(|prefix| {
                normalized
                    .strip_prefix(prefix)
                    .is_some_and(|s| s.starts_with(|c: char| c.is_ascii_digit()))
            }) {
                for center in raw["centers"].as_array().into_iter().flatten() {
                    let code = rad_str(center, "id");
                    if code.len() >= 2 && code.is_ascii() {
                        names.insert(format!("{}{}", &code[..2], normalized));
                    }
                }
            }
        }
        let words = name.split_whitespace().take(3).collect::<Vec<_>>();
        for n in 2..=words.len() {
            let candidate = words[..n].join("");
            if candidate.chars().any(|c| c.is_ascii_digit()) {
                names.insert(area_name(&candidate));
            }
        }
        areas.push(SpecialArea {
            id,
            name,
            kind: rad_str(raw, "type").into(),
            floor: raw["minimumAlt"].as_f64(),
            ceiling: raw["maximumAlt"].as_f64(),
            raw: raw.clone(),
            polygon,
            bounds,
            names,
        });
    }

    Ok(areas)
}

fn special_area_active(area: &SpecialArea, at: DateTime<Utc>) -> RadTruth {
    let details = rad_str(&area.raw, "activationDetails").to_ascii_uppercase();
    if [
        "NOTAM",
        "COORDINATION",
        "ON REQUEST",
        "BY ATC",
        "WHEN ACTIVE",
        "AUP",
        "UUP",
        "AGL",
        "AS NOTIFIED",
        "SUMMER",
        "WINTER",
        "HOLIDAY",
        "JAN",
        "FEB",
        "MAR",
        "APR",
        "MAY",
        "JUN",
        "JUL",
        "AUG",
        "SEP",
        "OCT",
        "NOV",
        "DEC",
    ]
    .iter()
    .any(|s| details.contains(s))
    {
        return RadTruth::Unknown;
    }
    if details.trim() == "H24" || details.trim() == "PERMANENTLY ACTIVE" {
        return RadTruth::Yes;
    }
    let Some(times) = area.raw["times"].as_array().filter(|a| !a.is_empty()) else {
        return RadTruth::Unknown;
    };
    let keys = [
        "dayMon", "dayTue", "dayWed", "dayThu", "dayFri", "daySat", "daySun",
    ];
    let minute = (at.hour() * 60 + at.minute()) as i32;
    let day = at.weekday().num_days_from_monday() as usize;
    let mut result = RadTruth::No;
    for time in times {
        let parse = |s: &str| -> Option<i32> {
            let p = s.split(':').collect::<Vec<_>>();
            let h = p.first()?.parse::<i32>().ok()?;
            let m = p.get(1)?.parse::<i32>().ok()?;
            (h < 24 && m < 60 && h >= 0 && m >= 0).then_some(h * 60 + m)
        };
        let (Some(start), Some(end)) = (
            parse(rad_str(time, "startTime")),
            parse(rad_str(time, "endTime")),
        ) else {
            result = result.or(RadTruth::Unknown);
            continue;
        };
        let enabled = |d: usize| {
            time[keys[d]]
                .as_bool()
                .map(|b| if b { RadTruth::Yes } else { RadTruth::No })
                .unwrap_or(RadTruth::Unknown)
        };
        let active = if start == end {
            enabled(day)
        } else if start < end {
            if minute >= start && minute < end {
                enabled(day)
            } else {
                RadTruth::No
            }
        } else if minute >= start {
            enabled(day)
        } else if minute < end {
            enabled((day + 6) % 7)
        } else {
            RadTruth::No
        };
        result = result.or(active);
    }
    result
}

// Exact polygon-edge and altitude-plane cuts: an entire crossing between two
// outside endpoints is found, and route gaps are never connected.
fn rad_crossings(
    points: &[iatfm_core::dashboard::VerticalProfilePoint],
    polygon: &[Point],
    floor: f64,
    ceiling: f64,
) -> Vec<(f64, f64)> {
    if polygon.len() < 3 || floor > ceiling {
        return Vec::new();
    }
    let ring = Polygon::new(
        LineString::new(
            polygon
                .iter()
                .map(|p| Coord { x: p.lon, y: p.lat })
                .collect(),
        ),
        vec![],
    );
    let bounds = polygon
        .iter()
        .fold([180_f64, 90_f64, -180_f64, -90_f64], |b, p| {
            [
                b[0].min(p.lon),
                b[1].min(p.lat),
                b[2].max(p.lon),
                b[3].max(p.lat),
            ]
        });
    let mut result = Vec::new();
    for pair in points.windows(2) {
        let (Some(a), Some(b), Some(t0), Some(t1), Some(h0), Some(h1)) = (
            pair[0].position,
            pair[1].position,
            pair[0].minute_offset,
            pair[1].minute_offset,
            pair[0].altitude_ft,
            pair[1].altitude_ft,
        ) else {
            continue;
        };
        if t1 < t0
            || (a.lon - b.lon).abs() > 180.
            || a.lon.max(b.lon) < bounds[0]
            || a.lon.min(b.lon) > bounds[2]
            || a.lat.max(b.lat) < bounds[1]
            || a.lat.min(b.lat) > bounds[3]
            || h0.max(h1) < floor
            || h0.min(h1) > ceiling
        {
            continue;
        }
        let dx = b.lon - a.lon;
        let dy = b.lat - a.lat;
        let mut cuts = vec![0., 1.];
        for i in 0..polygon.len() {
            let c = polygon[i];
            let d = polygon[(i + 1) % polygon.len()];
            let ex = d.lon - c.lon;
            let ey = d.lat - c.lat;
            let den = dx * ey - dy * ex;
            if den.abs() < 1e-12 {
                continue;
            }
            let u = ((c.lon - a.lon) * ey - (c.lat - a.lat) * ex) / den;
            let v = ((c.lon - a.lon) * dy - (c.lat - a.lat) * dx) / den;
            if (0.0..=1.0).contains(&u) && (0.0..=1.0).contains(&v) {
                cuts.push(u);
            }
        }
        if (h1 - h0).abs() > 1e-9 {
            for h in [floor, ceiling] {
                let f = (h - h0) / (h1 - h0);
                if f > 0. && f < 1. {
                    cuts.push(f);
                }
            }
        }
        cuts.sort_by(f64::total_cmp);
        cuts.dedup_by(|a, b| (*a - *b).abs() < 1e-9);
        for span in cuts.windows(2) {
            let f = (span[0] + span[1]) / 2.;
            let h = h0 + (h1 - h0) * f;
            if h >= floor
                && h <= ceiling
                && ring.contains(&geo::Point::new(a.lon + dx * f, a.lat + dy * f))
            {
                result.push((
                    f64::from(t0) + f64::from(t1 - t0) * span[0],
                    f64::from(t0) + f64::from(t1 - t0) * span[1],
                ));
            }
        }
    }
    result
}

fn area_geometry(area: &SpecialArea) -> RadValue {
    rad_json!({"id":area.id,"label":area.name,"blocks":[{"sectorId":area.name,"floorFt":area.floor,"ceilingFt":area.ceiling,"polygon":area.polygon.iter().map(|p|[p.lat,p.lon]).collect::<Vec<_>>()}],"airports":[],"points":[]})
}

// Sample within [entry, exit), never before entry or after exit. Activation
// schedules have minute precision, but geometry crossings have subminute timing.
fn rad_span_seconds(start: f64, end: f64, second: u32) -> Vec<i64> {
    let first = (start * 60.).floor() as i64;
    let last = (end * 60.).ceil() as i64 - 1;
    if first > last {
        return Vec::new();
    }
    let mut values = vec![first];
    let phase = i64::from(second);
    let mut boundary = ((first + phase).div_euclid(60) + 1) * 60 - phase;
    while boundary <= last {
        values.push(boundary);
        boundary += 60;
    }
    values
}

impl AppState {
    fn rad_catalogue(&self) -> Result<Arc<RadCatalogue>, String> {
        let path = self.data_dir.join("rad/catalogue.json");
        let modified = fs::metadata(&path)
            .and_then(|m| m.modified())
            .map_err(|_| "RAD catalogue unavailable. Import a Rolling RAD workbook.".to_string())?;
        let mut cache = self.rad_cache.lock().map_err(|_| "RAD cache unavailable")?;
        if cache.modified == Some(modified) {
            return cache
                .catalogue
                .clone()
                .ok_or_else(|| cache.error.clone().unwrap_or_default());
        }
        let loaded = File::open(&path)
            .map_err(|e| e.to_string())
            .and_then(|f| {
                serde_json::from_reader::<_, RadCatalogue>(BufReader::new(f))
                    .map_err(|e| e.to_string())
            })
            .and_then(|c| {
                if c.schema == "iatfm-rad/1" {
                    Ok(Arc::new(c))
                } else {
                    Err("Unsupported RAD schema".into())
                }
            });
        cache.modified = Some(modified);
        match loaded {
            Ok(c) => {
                cache.catalogue = Some(c.clone());
                cache.error = None;
                Ok(c)
            }
            Err(e) => {
                cache.catalogue = None;
                cache.error = Some(e.clone());
                Err(e)
            }
        }
    }

    fn refresh_special_areas(&self) {
        let result = ivao::fetch_special_areas_body()
            .and_then(|body| serde_json::from_str::<RadValue>(&body).map_err(AppError::from));
        let result = result
            .map_err(|e| e.to_string())
            .and_then(|raw| parse_special_areas(&raw).map(|areas| (raw, areas)));
        match result {
            Ok((raw, areas)) => {
                let at = Utc::now();
                let incomplete = raw.as_array().map_or(0, Vec::len) > areas.len();
                let mut cache = self.special_area_cache.write().unwrap();
                *cache = SpecialAreaCache {
                    areas: Arc::new(areas),
                    fetched_at: Some(at),
                    error: incomplete.then(|| {
                        "Some IVAO areas lack usable geometry; coverage is incomplete.".into()
                    }),
                };
                drop(cache);
                let path = self.data_dir.join("ivao-special-areas.json");
                let temp = path.with_extension("json.tmp");
                if fs::write(&temp, rad_json!({"fetchedAt":at,"areas":raw}).to_string()).is_ok() {
                    let _ = fs::rename(temp, path);
                }
            }
            Err(error) => self.special_area_cache.write().unwrap().error = Some(error),
        }
    }
}

fn load_special_area_cache(data_dir: &Path) -> SpecialAreaCache {
    let result = fs::read(data_dir.join("ivao-special-areas.json"))
        .ok()
        .and_then(|s| serde_json::from_slice::<RadValue>(&s).ok());
    if let Some(raw) = result
        && let Ok(areas) = parse_special_areas(&raw["areas"])
    {
        let incomplete = raw["areas"].as_array().map_or(0, Vec::len) > areas.len();
        return SpecialAreaCache {
            areas: Arc::new(areas),
            fetched_at: raw["fetchedAt"].as_str().and_then(|s| s.parse().ok()),
            error: incomplete
                .then(|| "Some IVAO areas lack usable geometry; coverage is incomplete.".into()),
        };
    }
    SpecialAreaCache {
        error: Some("IVAO special areas have not been downloaded.".into()),
        ..Default::default()
    }
}

fn start_special_area_refresher(state: Arc<AppState>) {
    thread::spawn(move || {
        loop {
            state.refresh_special_areas();
            thread::sleep(Duration::from_secs(120));
        }
    });
}

struct RadContext<'a> {
    support: Arc<RadValue>,
    support_offsets: Vec<i64>,
    rule_key: String,
    rule_id: String,
    pilot: &'a Pilot,
    points: &'a [iatfm_core::dashboard::VerticalProfilePoint],
    reference: &'a ReferenceData,
    areas: &'a SpecialAreaCache,
    at: DateTime<Utc>,
    takeoff: DateTime<Utc>,
    groups: BTreeMap<String, Vec<String>>,
    aliases: BTreeMap<String, String>,
    geometry: BTreeMap<String, RadValue>,
    visits: BTreeMap<String, RadTruth>,
    matches: BTreeMap<String, Vec<usize>>,
    area_lookup: BTreeMap<String, Vec<usize>>,
    candidate_lookup: BTreeMap<String, Vec<usize>>,
    sector_lookup: BTreeMap<String, usize>,
    procedure_ids: BTreeSet<String>,
    unresolved: BTreeSet<String>,
    spans: BTreeMap<String, Vec<(f64, f64)>>,
}

fn rad_wildcard(pattern: &str, value: &str) -> bool {
    // RAD airport ** notation uses one wildcard per character.
    pattern.len() == value.len()
        && pattern
            .chars()
            .zip(value.chars())
            .all(|(a, b)| a == '*' || a == b)
}

impl RadContext<'_> {
    fn area_indices(&mut self, id: &str) -> Vec<usize> {
        if let Some(found) = self.matches.get(id) {
            return found.clone();
        }
        let key = area_name(id);
        let explicit = self.aliases.get(id).or_else(|| self.aliases.get(&key));
        let found = if let Some(explicit) = explicit {
            self.areas
                .areas
                .iter()
                .position(|a| &a.id == explicit)
                .into_iter()
                .collect()
        } else {
            self.area_lookup.get(&key).cloned().unwrap_or_default()
        };
        self.matches.insert(id.into(), found.clone());
        found
    }
    fn airport(&self, pattern: &str, actual: &str, depth: u8) -> RadTruth {
        if pattern == "*" {
            return rad_bool(!actual.is_empty());
        }
        if depth > 8 {
            return RadTruth::Unknown;
        }
        if let Some(members) = self.groups.get(pattern) {
            if members.is_empty() {
                return RadTruth::Unknown;
            }
            return members.iter().fold(RadTruth::No, |s, m| {
                s.or(self.airport(m, actual, depth + 1))
            });
        }
        if pattern.ends_with("_GROUP") || pattern.ends_with("_AREA") {
            return RadTruth::Unknown;
        }
        if pattern.len() != 4 {
            return RadTruth::Unknown;
        }
        if rad_wildcard(pattern, actual) {
            RadTruth::Yes
        } else {
            RadTruth::No
        }
    }
    fn via(&mut self, id: &str) -> RadTruth {
        if let Some(value) = self.visits.get(id) {
            return *value;
        }
        if id.contains('*') {
            let ids = self
                .sector_lookup
                .keys()
                .filter(|s| rad_wildcard(id, s))
                .cloned()
                .collect::<Vec<_>>();
            if ids.is_empty() {
                return RadTruth::Unknown;
            }
            let mut truth = RadTruth::No;
            let mut spans = vec![];
            for resolved in &ids {
                truth = truth.or(self.via(resolved));
                spans.extend(self.spans.get(resolved).into_iter().flatten().copied());
            }
            self.spans.insert(id.into(), rad_merge_spans(spans));
            self.visits.insert(id.into(), truth);
            return truth;
        }
        let named = self.points.iter().any(|p| p.name.eq_ignore_ascii_case(id));
        let mut truth = if named {
            RadTruth::Yes
        } else {
            RadTruth::Unknown
        };
        let mut blocks = Vec::<RadValue>::new();
        let mut markers = Vec::<RadValue>::new();
        if let Some(p) = self
            .points
            .iter()
            .find(|p| p.name.eq_ignore_ascii_case(id))
            .and_then(|p| p.position)
        {
            markers.push(rad_json!({"id":id,"position":[p.lat,p.lon]}));
        }
        if let Some(p) = self.reference.navdata.points.get(id) {
            markers.push(rad_json!({"id":id,"position":[p.lat,p.lon]}));
            truth = if named { RadTruth::Yes } else { RadTruth::No };
        }
        if let Some(a) = self.reference.navdata.airports.get(id) {
            markers.push(rad_json!({"id":id,"position":[a.position.lat,a.position.lon]}));
            truth = if named { RadTruth::Yes } else { RadTruth::No };
        }
        if let Some(sector) = self
            .sector_lookup
            .get(id)
            .map(|i| &self.reference.sectors[*i])
        {
            truth = RadTruth::No;
            for block in &sector.blocks {
                let floor = block.floor_ft.unwrap_or(0.);
                let ceiling = block.ceiling_ft.unwrap_or(66000.);
                let crossed = rad_crossings(self.points, &block.polygon, floor, ceiling);
                if !crossed.is_empty() {
                    truth = RadTruth::Yes;
                }
                self.spans.entry(id.into()).or_default().extend(crossed);
            }
            if let Some(spans) = self.spans.get_mut(id) {
                *spans = rad_merge_spans(std::mem::take(spans));
            }
        }
        let matches = self.area_indices(id);
        if matches.len() == 1 {
            let area = &self.areas.areas[matches[0]];
            let crossed = rad_crossings(
                self.points,
                &area.polygon,
                area.floor.unwrap_or(0.),
                area.ceiling.unwrap_or(66000.),
            );
            self.spans.insert(id.into(), crossed.clone());
            let g = area_geometry(area);
            blocks.extend(g["blocks"].as_array().unwrap().clone());
            truth = if area.floor.is_none() || area.ceiling.is_none() {
                RadTruth::Unknown
            } else if crossed.is_empty() {
                RadTruth::No
            } else {
                RadTruth::Yes
            };
        } else if matches.len() > 1 {
            truth = RadTruth::Unknown;
        }
        // Procedures/airways are filed designators, not ordinary point names.
        let tokens = self.route_tokens();
        let procedure = self.procedure_ids.contains(id);
        if procedure
            || self.reference.navdata.airways.contains_key(id)
            || self.reference.navdata.airway_segments.contains_key(id)
        {
            truth = rad_bool(tokens.iter().any(|t| t == id));
        }
        self.geometry.insert(
            id.into(),
            rad_json!({"id":id,"blocks":blocks,"points":markers,"airports":[]}),
        );
        self.visits.insert(id.into(), truth);
        truth
    }
    fn eval(&mut self, node: &RadValue) -> RadTruth {
        let result = self.eval_node(node);
        if result == RadTruth::Unknown {
            let reason = match rad_str(node, "op") {
                "unknown" => {
                    if rad_str(node, "reason").is_empty() {
                        "unsupportedSyntax"
                    } else {
                        rad_str(node, "reason")
                    }
                }
                "via" | "boundary" | "boundaryAny" | "dep" | "arr" => "unresolvedReference",
                "active" | "activeAtLevel" => "unconfirmedActivation",
                "holiday" | "activationWindows" => "externalSchedule",
                "engineType" | "aircraft" | "pbn" | "flightType" | "flightRules"
                | "flightPurpose" => "missingFlightAttribute",
                "level" => "unresolvedLevel",
                "ordered" | "route" | "sequence" => "incompleteTrajectory",
                _ => "",
            };
            if !reason.is_empty() {
                self.unresolved.insert(reason.into());
            }
        }
        result
    }
    fn eval_node(&mut self, node: &RadValue) -> RadTruth {
        let args = node["args"].as_array().cloned().unwrap_or_default();
        let values = rad_values(node);
        match rad_str(node, "op") {
            "true" => RadTruth::Yes,
            "unknown" => {
                if rad_str(node, "reason") == "externalSchedule" {
                    self.support_fact(rad_str(node, "text"))
                } else {
                    RadTruth::Unknown
                }
            }
            "not" => args
                .first()
                .map(|n| self.eval(n).not())
                .unwrap_or(RadTruth::Unknown),
            "and" => args.iter().fold(RadTruth::Yes, |s, n| s.and(self.eval(n))),
            "or" => args.iter().fold(RadTruth::No, |s, n| s.or(self.eval(n))),
            "dep" | "arr" => {
                let actual = self
                    .pilot
                    .flight_plan
                    .as_ref()
                    .and_then(|p| {
                        if rad_str(node, "op") == "dep" {
                            p.departure_id.as_deref()
                        } else {
                            p.arrival_id.as_deref()
                        }
                    })
                    .unwrap_or("")
                    .to_ascii_uppercase();
                values
                    .iter()
                    .fold(RadTruth::No, |s, v| s.or(self.airport(v, &actual, 0)))
            }
            "flightType" | "aircraft" | "pbn" => {
                let plan = self.pilot.flight_plan.as_ref();
                let kind = rad_str(node, "op");
                let actual = match kind {
                    "flightType" => plan.and_then(|p| p.flight_type.as_deref()),
                    "aircraft" => plan.and_then(|p| p.aircraft_id.as_deref()),
                    _ => plan
                        .and_then(|p| p.remarks.as_deref())
                        .and_then(|s| s.split_whitespace().find_map(|s| s.strip_prefix("PBN/"))),
                };
                let Some(actual) = actual else {
                    return RadTruth::Unknown;
                };
                if values.iter().any(|v| {
                    if kind == "pbn" {
                        actual
                            .as_bytes()
                            .chunks(2)
                            .any(|chunk| chunk == v.as_bytes())
                    } else {
                        rad_wildcard(v, actual)
                    }
                }) {
                    RadTruth::Yes
                } else if kind == "aircraft"
                    && values.iter().any(|v| {
                        matches!(*v, "HEL" | "HELICOPTER" | "JET" | "TURBOPROP" | "PISTON")
                    })
                {
                    RadTruth::Unknown
                } else {
                    RadTruth::No
                }
            }
            "via" => values.iter().fold(RadTruth::No, |s, v| s.or(self.via(v))),
            "sequence" => {
                let route = self
                    .pilot
                    .flight_plan
                    .as_ref()
                    .and_then(|p| p.route.as_deref())
                    .unwrap_or("");
                let tokens = route
                    .split_whitespace()
                    .map(|p| p.split('/').next().unwrap_or(p))
                    .collect::<Vec<_>>();
                if !values.is_empty()
                    && tokens.windows(values.len()).any(|w| w == values.as_slice())
                {
                    RadTruth::Yes
                } else {
                    RadTruth::No
                }
            }
            "direct" => {
                if values.len() != 2 {
                    return RadTruth::Unknown;
                }
                let plan = self.pilot.flight_plan.as_ref();
                let mut tokens = vec![plan.and_then(|p| p.departure_id.as_deref()).unwrap_or("")];
                tokens.extend(
                    plan.and_then(|p| p.route.as_deref())
                        .unwrap_or("")
                        .split_whitespace()
                        .map(|p| p.split('/').next().unwrap_or(p)),
                );
                tokens.push(plan.and_then(|p| p.arrival_id.as_deref()).unwrap_or(""));
                if tokens
                    .windows(3)
                    .any(|w| w[0] == values[0] && w[1] == "DCT" && w[2] == values[1])
                {
                    RadTruth::Yes
                } else {
                    RadTruth::No
                }
            }
            "level" => {
                if node.get("location").is_some() {
                    let (e, u) = self.events(node);
                    return if !e.is_empty() {
                        RadTruth::Yes
                    } else if u {
                        RadTruth::Unknown
                    } else {
                        RadTruth::No
                    };
                }
                let Some(h) = self.filed_altitude() else {
                    return RadTruth::Unknown;
                };
                rad_level_compare(h, node)
            }
            "active" => values.iter().fold(RadTruth::No, |state, id| {
                let found = self.area_indices(id);
                state.or(if found.len() == 1 {
                    self.area_active(found[0], self.at)
                } else {
                    RadTruth::Unknown
                })
            }),
            "time" => {
                let m = i64::from(self.at.hour() * 60 + self.at.minute());
                let Some(start) = node["start"].as_i64() else {
                    return RadTruth::Unknown;
                };
                let Some(end) = node["end"].as_i64() else {
                    return RadTruth::Unknown;
                };
                if if start < end {
                    m >= start && m < end
                } else {
                    m >= start || m < end
                } {
                    RadTruth::Yes
                } else {
                    RadTruth::No
                }
            }
            _ => self.eval_extended(node),
        }
    }
    fn filed_altitude(&self) -> Option<f64> {
        let level = self.pilot.flight_plan.as_ref()?.level.as_deref()?;
        if let Some(n) = level
            .strip_prefix("FL")
            .or_else(|| level.strip_prefix('F'))
            .or_else(|| level.strip_prefix('A'))
        {
            n.parse::<f64>().ok().map(|n| n * 100.)
        } else {
            level.parse().ok()
        }
    }
    fn fua_schedule(&mut self, node: &RadValue, minute: f64) -> RadTruth {
        match rad_str(node, "op") {
            "active" => rad_values(node).iter().fold(RadTruth::No, |state, id| {
                let crossed = self.via(id);
                let at_crossing = if crossed == RadTruth::Yes {
                    if self.spans.get(*id).is_some_and(|spans| {
                        spans
                            .iter()
                            .any(|(start, end)| minute + 1. / 60. > *start && minute < *end)
                    }) {
                        RadTruth::Yes
                    } else {
                        RadTruth::No
                    }
                } else {
                    crossed
                };
                state.or(at_crossing.and(self.eval(&rad_json!({"op":"active","values":[id]}))))
            }),
            "and" => node["args"]
                .as_array()
                .into_iter()
                .flatten()
                .fold(RadTruth::Yes, |s, n| s.and(self.fua_schedule(n, minute))),
            "or" => node["args"]
                .as_array()
                .into_iter()
                .flatten()
                .fold(RadTruth::No, |s, n| s.or(self.fua_schedule(n, minute))),
            _ => self.eval(node),
        }
    }
    fn rule_geometry(&mut self, rule: &RadValue) -> RadValue {
        let mut blocks = Vec::new();
        let mut points = Vec::new();
        let mut unresolved = Vec::new();
        for id in rule["refs"]
            .as_array()
            .into_iter()
            .flatten()
            .filter_map(RadValue::as_str)
        {
            self.via(id);
            if id.contains('*') {
                for index in self
                    .sector_lookup
                    .iter()
                    .filter(|(s, _)| rad_wildcard(id, s))
                    .map(|(_, i)| *i)
                {
                    blocks.extend(crate::templates::rad_sector_blocks(
                        &self.reference.sectors[index],
                    ));
                }
            }
            if let Some(index) = self.sector_lookup.get(id)
                && let Some(g) = self.geometry.get_mut(id)
                && g["blocks"].as_array().is_none_or(Vec::is_empty)
            {
                g["blocks"] = rad_json!(crate::templates::rad_sector_blocks(
                    &self.reference.sectors[*index]
                ));
            }
            if let Some(g) = self.geometry.get(id) {
                blocks.extend(g["blocks"].as_array().into_iter().flatten().cloned());
                points.extend(g["points"].as_array().into_iter().flatten().cloned());
                if g["blocks"].as_array().is_none_or(Vec::is_empty)
                    && g["points"].as_array().is_none_or(Vec::is_empty)
                {
                    unresolved.push(id.to_string());
                }
            }
        }
        let mut line = Vec::new();
        if matches!(rad_str(&rule["scope"], "op"), "direct" | "sequence") {
            for id in rad_values(&rule["scope"]) {
                if let Some(p) = self.reference.navdata.points.get(id) {
                    line.push([p.lat, p.lon]);
                }
            }
        }
        rad_json!({"id":rule["id"],"label":rule["sheet"],"blocks":blocks,"points":points,"airports":[],"lines":if line.len()>1{vec![line]}else{vec![]},"unresolvedReferences":unresolved})
    }
}

fn rad_issue(rule: &RadValue, status: &str, message: &str, geometry: RadValue) -> RadValue {
    let text = rad_str(rule, "text")
        .split_whitespace()
        .collect::<Vec<_>>()
        .join(" ");
    let message = if status == "error" && !text.is_empty() {
        let excerpt = text.chars().take(320).collect::<String>();
        format!(
            "{message} {excerpt}{}",
            if text.chars().count() > 320 {
                "ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦"
            } else {
                ""
            }
        )
    } else {
        message.to_string()
    };
    rad_json!({"field":format!("RAD {}",rad_str(rule,"id")),"status":status,"message":message,"ruleId":rule["id"],"ruleKey":rule["key"],"rule":{"sheet":rule["sheet"],"row":rule["row"],"text":rule["text"],"fields":rule["fields"],"validFrom":rule["validFrom"],"validUntil":rule["validUntil"]},"geometry":geometry})
}

impl AppState {
    fn check_rad_and_areas(
        &self,
        pilot: &Pilot,
        points: &[iatfm_core::dashboard::VerticalProfilePoint],
        reference: &ReferenceData,
        takeoff: DateTime<Utc>,
    ) -> (Vec<RadValue>, RadValue) {
        let catalogue = self.rad_catalogue();
        let original_cache = self.special_area_cache.read().unwrap().clone();
        let support_result = self.rad_support();
        let mut support_error = support_result.as_ref().err().cloned();
        let support = support_result.unwrap_or_else(|_| Arc::new(rad_json!({})));
        let end = takeoff
            + ChronoDuration::minutes(i64::from(
                points
                    .iter()
                    .filter_map(|p| p.minute_offset)
                    .max()
                    .unwrap_or(0),
            ));
        let valid_support =
            rad_support_valid(&support, takeoff) && rad_support_valid(&support, end);
        if support.get("schema").is_some() && !valid_support {
            support_error =
                Some("Local RAD context does not cover the full trajectory time interval".into());
        }
        let cache = if valid_support {
            match rad_support_areas(&original_cache, &support) {
                Ok(c) => c,
                Err(e) => {
                    support_error = Some(e);
                    original_cache
                }
            }
        } else {
            original_cache
        };
        let alias_path = self.data_dir.join("rad/ivao-aliases.json");
        let aliases_result = if alias_path.exists() {
            fs::read(alias_path)
                .map_err(|e| e.to_string())
                .and_then(|s| {
                    serde_json::from_slice::<BTreeMap<String, String>>(&s)
                        .map_err(|e| e.to_string())
                })
        } else {
            Ok(BTreeMap::new())
        };
        let alias_error = aliases_result.as_ref().err().cloned();
        let aliases = aliases_result.unwrap_or_default();
        let mut area_lookup: BTreeMap<String, Vec<usize>> = BTreeMap::new();
        let mut candidate_lookup: BTreeMap<String, Vec<usize>> = BTreeMap::new();
        for (i, area) in cache.areas.iter().enumerate() {
            for name in &area.names {
                area_lookup.entry(name.clone()).or_default().push(i);
                if name.len() >= 2 {
                    let key = format!(
                        "{}{}",
                        &name[..2],
                        name.chars()
                            .filter(char::is_ascii_digit)
                            .collect::<String>()
                    );
                    candidate_lookup.entry(key).or_default().push(i);
                }
            }
        }
        let sector_lookup = reference
            .sectors
            .iter()
            .enumerate()
            .filter_map(|(i, s)| Some((s.id.clone()?, i)))
            .collect();
        let support_offsets = rad_support_offsets(&support, takeoff);
        let mut context = RadContext {
            support,
            support_offsets,
            rule_key: String::new(),
            rule_id: String::new(),
            pilot,
            points,
            reference,
            areas: &cache,
            at: takeoff,
            takeoff,
            groups: BTreeMap::new(),
            aliases,
            geometry: BTreeMap::new(),
            visits: BTreeMap::new(),
            matches: BTreeMap::new(),
            area_lookup,
            candidate_lookup,
            sector_lookup,
            procedure_ids: reference
                .navdata
                .procedures
                .values()
                .flatten()
                .map(|p| p.name.clone())
                .collect(),
            unresolved: BTreeSet::new(),
            spans: BTreeMap::new(),
        };
        let mut issues = Vec::new();
        if let Some(error) = support_error {
            issues
                .push(rad_json!({"field":"RAD local context","status":"warning","message":error}));
        }
        if let Some(error) = alias_error {
            issues.push(rad_json!({"field":"RAD area aliases","status":"warning","message":"The IVAO alias file could not be loaded; configured correspondences were not applied.","details":error}));
        }
        let mut tested = 0;
        let mut incomplete = 0;
        let mut applicable = 0;
        let mut unresolved_counts: BTreeMap<String, u64> = BTreeMap::new();
        let fresh = cache
            .fetched_at
            .is_some_and(|at| Utc::now() - at <= ChronoDuration::minutes(10));
        if !fresh || cache.error.is_some() {
            issues.push(rad_json!({"field":"IVAO areas","status":"warning","message":"Special-area data unavailable, stale or refresh failed; absence of conflicts cannot be certified.","details":cache.error}));
        }
        // Crossings are checked at each minute inside the exact intersection,
        // starting at entry and excluding exit; an activation mid-crossing is detected.
        for (area_index, area) in cache.areas.iter().enumerate() {
            if points
                .iter()
                .filter_map(|p| p.position)
                .all(|p| p.lon < area.bounds[0])
                || points
                    .iter()
                    .filter_map(|p| p.position)
                    .all(|p| p.lon > area.bounds[2])
            {
                continue;
            }
            let spans = rad_crossings(
                points,
                &area.polygon,
                area.floor.unwrap_or(0.),
                area.ceiling.unwrap_or(66000.),
            );
            if spans.is_empty() {
                continue;
            }
            let mut active = RadTruth::No;
            for (start, end) in &spans {
                for second in context.sample_seconds(*start, *end) {
                    active = active
                        .or(context
                            .area_active(area_index, takeoff + ChronoDuration::seconds(second)));
                }
            }
            if area.floor.is_none() || area.ceiling.is_none() {
                active = RadTruth::Unknown;
            }
            if active == RadTruth::No {
                continue;
            }
            let hard = active == RadTruth::Yes && area.kind == "P";
            issues.push(rad_json!({"field":format!("IVAO {}",area.name),"status":if hard{"error"}else{"warning"},"message":if hard{"Trajectory crosses an active prohibited area."}else if active==RadTruth::Yes{"Trajectory crosses an active restricted/danger area; authorization or avoidance must be checked."}else{"Trajectory crosses a special area with unconfirmed activation or vertical limits."},"areaId":area.id,"geometry":area_geometry(area),"rule":{"text":area.raw["description"],"activation":area.raw["activationDetails"],"entryUtc":takeoff+ChronoDuration::seconds((spans[0].0*60.) as i64),"exitUtc":takeoff+ChronoDuration::seconds((spans.last().unwrap().1*60.) as i64)},"activation":if active==RadTruth::Yes{"active"}else{"unknown"}}));
        }
        let mut metadata = rad_json!({"officialIfps":false,"areasSampledAt":cache.fetched_at,"areasFresh":fresh,"localContext":{"source":context.support["source"],"validFrom":context.support["validFrom"],"validUntil":context.support["validUntil"],"validForTrajectory":valid_support}});
        let cat = match catalogue {
            Ok(c) => c,
            Err(error) => {
                issues.push(rad_json!({"field":"RAD","status":"warning","message":error}));
                return (issues, metadata);
            }
        };
        metadata["airac"] = cat.airac.clone().into();
        metadata["version"] = cat.version.clone().into();
        if let Some(manifest) = fs::read(self.data_dir.join("eurocontrol-iatfm/manifest.json"))
            .ok()
            .and_then(|s| serde_json::from_slice::<RadValue>(&s).ok())
        {
            if let Some(source_date) = manifest["summary"]["sourceDate"].as_str() {
                metadata["sectorSourceDate"] = source_date.into();
                if source_date < cat.valid_from.as_str() || source_date >= cat.valid_until.as_str()
                {
                    issues.push(rad_json!({"field":"RAD data consistency","status":"warning","message":format!("Sector catalogue dated {source_date} differs from RAD {} ({}); references and boundaries need confirmation.",cat.airac,cat.valid_from)}));
                }
            }
        }
        let date = takeoff.format("%Y-%m-%d").to_string();
        if date < cat.valid_from || date >= cat.valid_until {
            issues.push(rad_json!({"field":"RAD validity","status":"warning","message":format!("RAD {} v{} covers {} to {} (end excluded); flight is outside this interval.",cat.airac,cat.version,cat.valid_from,cat.valid_until)}));
            return (issues, metadata);
        }
        let mixed = pilot
            .flight_plan
            .as_ref()
            .and_then(|p| p.flight_rules.as_deref())
            .is_some_and(|s| s == "Y" || s == "Z");
        if mixed {
            issues.push(rad_json!({"field":"RAD flight rules","status":"warning","message":"Mixed IFR/VFR phase attribution is not resolved; RAD conflicts need confirmation for the IFR portion."}));
        }
        let vfr = pilot
            .flight_plan
            .as_ref()
            .and_then(|p| p.flight_rules.as_deref())
            .is_some_and(|s| s == "V" || s == "VFR");
        if vfr {
            metadata["radStatus"] = "notApplicable".into();
            return (issues, metadata);
        }
        let mut selected_groups: BTreeMap<String, &RadValue> = BTreeMap::new();
        for group in &cat.groups {
            let start = rad_str(group, "validFrom");
            let end = rad_str(group, "validUntil");
            if (start.is_empty() || start <= date.as_str())
                && (end.is_empty() || end >= date.as_str())
            {
                let rank = |g: &RadValue| {
                    (
                        rad_str(g, "validFrom").to_string(),
                        rad_str(g, "releaseDate").to_string(),
                        g["row"].as_u64().unwrap_or(0),
                    )
                };
                let id = rad_str(group, "id");
                if selected_groups
                    .get(id)
                    .is_none_or(|old| rank(group) > rank(old))
                {
                    selected_groups.insert(id.into(), group);
                }
            }
        }
        for (id, group) in selected_groups {
            if matches!(rad_str(group, "change"), "DEL" | "SUS") {
                continue;
            }
            context.groups.insert(
                id,
                group["members"]
                    .as_array()
                    .into_iter()
                    .flatten()
                    .filter_map(RadValue::as_str)
                    .map(str::to_string)
                    .collect(),
            );
        }
        // Same-ID revisions coexist in Rolling RAD. Select the latest applicable
        // validity/release tuple; never collapse IDs across different annexes.
        let mut selected: BTreeMap<(String, String), &RadValue> = BTreeMap::new();
        for rule in &cat.rules {
            let start = rad_str(rule, "validFrom");
            let end = rad_str(rule, "validUntil");
            if (!start.is_empty() && start > date.as_str())
                || (!end.is_empty() && end < date.as_str())
            {
                continue;
            }
            let key = (rad_str(rule, "sheet").into(), rad_str(rule, "id").into());
            let rank = |r: &RadValue| {
                (
                    rad_str(r, "validFrom").to_string(),
                    rad_str(r, "releaseDate").to_string(),
                    r["row"].as_u64().unwrap_or(0),
                )
            };
            if selected.get(&key).is_none_or(|old| rank(rule) > rank(old)) {
                selected.insert(key, rule);
            }
        }
        let inactive = selected
            .values()
            .filter(|r| matches!(rad_str(r, "change"), "DEL" | "SUS"))
            .count();
        selected.retain(|_, r| !matches!(rad_str(r, "change"), "DEL" | "SUS"));
        metadata["inactiveRules"] = inactive.into();
        for rule in selected.values() {
            context.rule_key = rad_str(rule, "key").into();
            context.rule_id = rad_str(rule, "id").into();
            context.unresolved.clear();
            let scope = context.eval(&rule["scope"]);
            let applies = rule
                .get("appliesTo")
                .map(|n| context.eval(n))
                .unwrap_or(RadTruth::Yes);
            if applies == RadTruth::No {
                continue;
            }
            let mut relevant = scope != RadTruth::No;
            let mut violation = RadTruth::No;
            let clauses = rule["clauses"].as_array().cloned().unwrap_or_default();
            if clauses.is_empty() {
                incomplete += 1;
                *unresolved_counts
                    .entry("sourceUnspecified".into())
                    .or_default() += 1;
                continue;
            }
            // Restriction schedules use time at the restricted object, not EOBT.
            let mut scope_refs = Vec::new();
            rad_expression_refs(&rule["scope"], &mut scope_refs);
            let mut offsets = Vec::new();
            for id in scope_refs {
                offsets.extend(
                    points
                        .iter()
                        .filter(|p| p.name == id)
                        .filter_map(|p| p.minute_offset)
                        .map(|m| i64::from(m) * 60),
                );
                context.via(&id);
                for (start, end) in context.spans.get(&id).into_iter().flatten() {
                    offsets.extend(context.sample_seconds(*start, *end));
                }
            }
            offsets.sort_unstable();
            offsets.dedup();
            let time_unknown = offsets.is_empty()
                && scope != RadTruth::No
                && rad_str(&rule["schedule"], "op") != "true";
            if offsets.is_empty() {
                offsets.push(0);
            }
            for offset in offsets {
                context.at = takeoff + ChronoDuration::seconds(offset);
                let schedule = if time_unknown {
                    RadTruth::Unknown
                } else if rule["areas"].is_array() {
                    context.fua_schedule(&rule["schedule"], offset as f64 / 60.)
                } else {
                    context.eval(&rule["schedule"])
                };
                let mut instant_violation = RadTruth::No;
                for clause in &clauses {
                    let condition = context.eval(&clause["condition"]);
                    let v = match rad_str(clause, "action") {
                        "forbidden" => scope.and(condition),
                        "only" => scope.and(condition.not()),
                        "required" => {
                            relevant |= condition != RadTruth::No;
                            condition.and(scope.not())
                        }
                        "onlyRequired" => {
                            relevant |= condition != RadTruth::No;
                            scope.and(condition.not()).or(condition.and(scope.not()))
                        }
                        "cap" => {
                            let limit = &clause["limit"];
                            let satisfied = if rad_str(limit, "comparison") == "FL" {
                                context
                                    .filed_altitude()
                                    .zip(limit["value"].as_f64())
                                    .map(|(a, b)| if a <= b { RadTruth::Yes } else { RadTruth::No })
                                    .unwrap_or(RadTruth::Unknown)
                            } else {
                                context.eval(limit)
                            };
                            scope.and(condition).and(satisfied.not())
                        }
                        _ => RadTruth::Unknown,
                    };
                    let clause_schedule = clause
                        .get("schedule")
                        .map(|n| context.eval(n))
                        .unwrap_or(RadTruth::Yes);
                    instant_violation = instant_violation.or(v.and(clause_schedule));
                }
                violation = violation.or(instant_violation.and(applies).and(schedule));
            }
            context.at = takeoff;
            if let Some(limits) = rule["altitude"].as_array() {
                let parse = |v: &RadValue| {
                    v.as_str()
                        .and_then(|s| {
                            s.trim()
                                .strip_prefix("FL")
                                .unwrap_or(s.trim())
                                .parse::<f64>()
                                .ok()
                        })
                        .map(|n| n * 100.)
                };
                if let (Some(lo), Some(hi), Some(h)) = (
                    limits.first().and_then(parse),
                    limits.get(1).and_then(parse),
                    context.filed_altitude(),
                ) {
                    if h < lo || h > hi {
                        violation = RadTruth::No;
                    }
                } else {
                    violation = violation.and(RadTruth::Unknown);
                }
            }
            match violation {
                RadTruth::Yes => {
                    applicable += 1;
                    tested += 1;
                    let geometry = context.rule_geometry(rule);
                    issues.push(rad_issue(
                        rule,
                        if mixed { "warning" } else { "error" },
                        "Flight plan conflicts with this RAD rule.",
                        geometry,
                    ));
                }
                RadTruth::Unknown => {
                    incomplete += 1;
                    if context.unresolved.is_empty() {
                        context.unresolved.insert("unresolvedApplicability".into());
                    }
                    for reason in &context.unresolved {
                        *unresolved_counts.entry(reason.clone()).or_default() += 1;
                    }
                    if relevant && scope == RadTruth::Yes {
                        applicable += 1;
                        let geometry = context.rule_geometry(rule);
                        let mut issue = rad_issue(
                            rule,
                            "warning",
                            "Rule intersects this flight, but a condition, schedule, activation or reference could not be resolved.",
                            geometry,
                        );
                        issue["unresolvedReasons"] = rad_json!(context.unresolved);
                        issues.push(issue);
                    }
                }
                RadTruth::No => tested += 1,
            }
        }
        // Link IVAO crossings back to FUA rules and explain uncertain mappings.
        let mut mappings = Vec::new();
        let mut mapped_ids = BTreeSet::new();
        let mut unmatched = 0;
        for rule in selected.values().filter(|r| r["areas"].is_array()) {
            for id in rule["areas"]
                .as_array()
                .unwrap()
                .iter()
                .filter_map(RadValue::as_str)
            {
                let found = context.area_indices(id);
                if found.len() == 1 {
                    let area = &cache.areas[found[0]];
                    for issue in &mut issues {
                        if issue["areaId"].as_str() == Some(&area.id) {
                            if issue["rule"]["relatedRules"].is_null() {
                                issue["rule"]["relatedRules"] = rad_json!([]);
                                issue["rule"]["relatedRuleDetails"] = rad_json!([]);
                            }
                            let list = issue["rule"]["relatedRules"].as_array_mut().unwrap();
                            if !list.contains(&rule["id"]) {
                                list.push(rule["id"].clone());
                                issue["rule"]["relatedRuleDetails"].as_array_mut().unwrap().push(rad_json!({"id":rule["id"],"sheet":rule["sheet"],"row":rule["row"],"text":rule["text"],"fields":rule["fields"]}));
                            }
                        }
                    }
                    if mapped_ids.insert(id.to_string()) {
                        mappings.push(rad_json!({"radId":id,"ivaoId":area.id,"method":if context.aliases.contains_key(id)||context.aliases.contains_key(&area_name(id)){"explicitAlias"}else{"normalizedName"}}));
                    }
                } else {
                    if !mapped_ids.insert(id.to_string()) {
                        continue;
                    }
                    let key = area_name(id);
                    let candidates = if found.len() > 1 {
                        found
                    } else {
                        {
                            let bucket = if key.len() >= 2 {
                                format!(
                                    "{}{}",
                                    &key[..2],
                                    key.chars().filter(char::is_ascii_digit).collect::<String>()
                                )
                            } else {
                                String::new()
                            };
                            context
                                .candidate_lookup
                                .get(&bucket)
                                .into_iter()
                                .flatten()
                                .copied()
                                .filter(|i| {
                                    cache.areas[*i].names.iter().any(|n| rad_near_name(&key, n))
                                })
                                .collect::<BTreeSet<_>>()
                                .into_iter()
                                .collect()
                        }
                    };
                    if !candidates.is_empty() {
                        mappings.push(rad_json!({"radId":id,"method":"ambiguous","candidates":candidates.iter().map(|i|rad_json!({"id":cache.areas[*i].id,"name":cache.areas[*i].name})).collect::<Vec<_>>() }));
                    } else {
                        unmatched += 1;
                    }
                }
            }
        }
        if incomplete > 0 {
            issues.push(rad_json!({"field":"RAD coverage","status":"warning","message":format!("{incomplete} rules could not be fully evaluated; full RAD conformity is not established. {tested} rules evaluated." )}));
        }
        metadata["unmatchedAreas"] = unmatched.into();
        metadata["unresolvedReasons"] = rad_json!(unresolved_counts);
        metadata["evaluatedRules"] = tested.into();
        metadata["incompleteRules"] = incomplete.into();
        metadata["applicableIssues"] = applicable.into();
        metadata["takeoffUtc"] = takeoff.to_rfc3339().into();
        metadata["areaMappings"] = rad_json!(mappings);
        (issues, metadata)
    }
}
