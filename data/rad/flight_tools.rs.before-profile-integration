#[derive(Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
struct ManualFpl {
    callsign: String,
    aircraft: String,
    departure: String,
    arrival: String,
    date: String,
    eobt: String,
    level: String,
    speed: String,
    route: String,
    flight_rules: String,
}

#[derive(Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
struct IcaoFplInput {
    icao_text: String,
    #[serde(default)]
    date: Option<String>,
}

#[derive(Deserialize)]
#[serde(untagged)]
enum ManualFplInput {
    Icao(IcaoFplInput),
    Fields(ManualFpl),
}

fn icao_fpl_pilot(input: IcaoFplInput, nav: &Navdata) -> Result<Pilot, String> {
    let text = input.icao_text.trim();
    if text.len() > 16384 || !text.is_ascii() {
        return Err("ICAO FPL: use ASCII text, maximum 16384 characters.".into());
    }
    let body = text
        .strip_prefix('(')
        .and_then(|s| s.strip_suffix(')'))
        .ok_or("ICAO FPL: paste a complete message enclosed in (FPL-...).")?;
    if body.contains(['(', ')']) {
        return Err("ICAO FPL: only one message may be checked at a time.".into());
    }
    let normalized = body
        .split_whitespace()
        .collect::<Vec<_>>()
        .join(" ")
        .to_ascii_uppercase();
    // Item 18 is free text: keep its internal hyphens rather than treating them
    // as more mandatory fields. Supplementary information is retained, not validated.
    let fields = normalized.splitn(9, '-').map(str::trim).collect::<Vec<_>>();
    if fields.len() != 9 || fields[0] != "FPL" || fields.iter().any(|s| s.is_empty()) {
        return Err(
            "ICAO FPL: expected items 7, 8, 9, 10, 13, 15, 16 and 18, separated by hyphens.".into(),
        );
    }
    let callsign = fields[1];
    if callsign.is_empty()
        || callsign.len() > 7
        || !callsign.bytes().all(|b| b.is_ascii_alphanumeric())
    {
        return Err("Item 7: aircraft identification must contain 1 to 7 letters/digits.".into());
    }
    let rules = fields[2].replace(' ', "");
    if rules.len() != 2
        || !matches!(rules.as_bytes()[0], b'I' | b'V' | b'Y' | b'Z')
        || !matches!(rules.as_bytes()[1], b'S' | b'N' | b'G' | b'M' | b'X')
    {
        return Err("Item 8: expected flight rules and type, for example IS or IG.".into());
    }
    let (aircraft, wake) = fields[3]
        .split_once('/')
        .ok_or("Item 9: expected aircraft type/wake category, for example A320/M.")?;
    let aircraft = aircraft.trim();
    let wake = wake.trim();
    if aircraft.starts_with(|c: char| c.is_ascii_digit()) {
        return Err("Item 9: multiple-aircraft/formation plans are not supported by this single-flight simulation.".into());
    }
    if !(2..=4).contains(&aircraft.len())
        || !aircraft.bytes().all(|b| b.is_ascii_alphanumeric())
        || !["L", "M", "H", "J"].contains(&wake)
    {
        return Err("Item 9: invalid aircraft type or wake category.".into());
    }
    let (equipment, surveillance) = fields[4]
        .split_once('/')
        .ok_or("Item 10: expected equipment/surveillance, for example SDE2E3FGHIRWY/LB1.")?;
    if [equipment, surveillance]
        .iter()
        .any(|s| s.is_empty() || !s.bytes().all(|b| b.is_ascii_alphanumeric()))
    {
        return Err("Item 10: invalid equipment/surveillance syntax.".into());
    }
    let departure = fields[5].replace(' ', "");
    if departure.len() != 8 || !departure[..4].bytes().all(|b| b.is_ascii_alphabetic()) {
        return Err("Item 13: expected departure and UTC EOBT, for example LFPG1230.".into());
    }
    let eobt = &departure[4..];
    if !eobt.bytes().all(|b| b.is_ascii_digit())
        || eobt[..2].parse::<u32>().unwrap_or(24) > 23
        || eobt[2..].parse::<u32>().unwrap_or(60) > 59
    {
        return Err("Item 13: invalid UTC EOBT (HHMM).".into());
    }
    let (speed_level, route) = fields[6]
        .split_once(' ')
        .ok_or("Item 15: expected speed/level followed by the route, for example N0450F350 DCT.")?;
    let speed_len = match speed_level.as_bytes().first() {
        Some(b'N' | b'K') => 5,
        Some(b'M') => 4,
        _ => return Err("Item 15: speed must use N, K or M notation.".into()),
    };
    if speed_level.len() <= speed_len
        || !speed_level[1..speed_len]
            .bytes()
            .all(|b| b.is_ascii_digit())
    {
        return Err("Item 15: invalid initial speed/level.".into());
    }
    let filed_level = &speed_level[speed_len..];
    let level = match filed_level.as_bytes().first() {
        Some(b'F' | b'A')
            if filed_level.len() == 4 && filed_level[1..].bytes().all(|b| b.is_ascii_digit()) =>
        {
            filed_level.to_string()
        }
        Some(b'S' | b'M')
            if filed_level.len() == 5 && filed_level[1..].bytes().all(|b| b.is_ascii_digit()) =>
        {
            let metres = filed_level[1..].parse::<f64>().unwrap() * 10.;
            format!("{:.0}", metres / 0.3048)
        }
        _ if filed_level == "VFR" && rules.starts_with('V') => "VFR".into(),
        _ => {
            return Err("Item 15: unsupported or malformed initial level (F/A/S/M or VFR).".into());
        }
    };
    let destination = fields[7].split_whitespace().collect::<Vec<_>>();
    let arrival_eet = destination[0];
    if arrival_eet.len() != 8
        || !arrival_eet[..4].bytes().all(|b| b.is_ascii_alphabetic())
        || !arrival_eet[4..].bytes().all(|b| b.is_ascii_digit())
        || arrival_eet[6..].parse::<u32>().unwrap_or(60) > 59
        || destination.len() > 3
        || destination[1..]
            .iter()
            .any(|s| s.len() != 4 || !s.bytes().all(|b| b.is_ascii_alphabetic()))
    {
        return Err(
            "Item 16: expected arrival, total EET (HHMM) and optional alternate aerodromes.".into(),
        );
    }
    let dofs = fields[8]
        .split_whitespace()
        .filter_map(|s| s.strip_prefix("DOF/"))
        .collect::<Vec<_>>();
    let date = match dofs.as_slice() {
        [] => input
            .date
            .ok_or("Item 18: add DOF/YYMMDD or choose a UTC date below the message.")?,
        [dof] if dof.len() == 6 && dof.bytes().all(|b| b.is_ascii_digit()) => {
            chrono::NaiveDate::parse_from_str(&format!("20{dof}"), "%Y%m%d")
                .map_err(|_| "Item 18: invalid DOF/YYMMDD date.")?
                .format("%Y-%m-%d")
                .to_string()
        }
        _ => return Err("Item 18: provide one valid DOF/YYMMDD date.".into()),
    };
    let mut pilot = manual_fpl_pilot(
        ManualFpl {
            callsign: callsign.into(),
            aircraft: aircraft.into(),
            departure: departure[..4].into(),
            arrival: arrival_eet[..4].into(),
            date,
            eobt: format!("{}:{}", &eobt[..2], &eobt[2..]),
            level,
            speed: speed_level[..speed_len].into(),
            route: route.into(),
            flight_rules: rules[..1].into(),
        },
        nav,
    )?;
    let plan = pilot.flight_plan.as_mut().unwrap();
    plan.flight_type = Some(rules[1..].into());
    plan.wake_turbulence = Some(wake.into());
    plan.equipment = Some(equipment.into());
    plan.surveillance = Some(surveillance.into());
    plan.eet = Some(arrival_eet[4..].into());
    plan.remarks = Some(fields[8].into());
    Ok(pilot)
}

fn searched_callsign(request: &Request) -> Result<String, Response> {
    let params = parse_query_params(request.query.as_deref().unwrap_or_default());
    let id = params
        .get("callsign")
        .map(|s| s.trim().to_ascii_uppercase())
        .unwrap_or_default();
    if !(2..=16).contains(&id.len()) || !id.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'-')
    {
        return Err(Response::bad_request(
            "Enter an aircraft callsign (2–16 letters/digits).".into(),
        ));
    }
    Ok(id)
}

fn manual_fpl_pilot(input: ManualFpl, nav: &Navdata) -> Result<Pilot, String> {
    use iatfm_core::models::{FlightPlan, LastTrack};
    let callsign = input.callsign.trim().to_ascii_uppercase();
    if !(1..=16).contains(&callsign.len())
        || !callsign
            .bytes()
            .all(|c| c.is_ascii_alphanumeric() || c == b'-')
    {
        return Err("Invalid callsign.".into());
    }
    if input.route.len() > 4096
        || [
            &input.aircraft,
            &input.departure,
            &input.arrival,
            &input.level,
            &input.speed,
            &input.flight_rules,
        ]
        .iter()
        .any(|s| s.len() > 32)
    {
        return Err("Flight plan field is too long.".into());
    }
    let date = chrono::NaiveDate::parse_from_str(&input.date, "%Y-%m-%d")
        .map_err(|_| "Date must be YYYY-MM-DD.".to_string())?;
    let minute = parse_hhmm_utc("EOBT", &input.eobt)?;
    let departure = input.departure.trim().to_ascii_uppercase();
    let track = nav.airports.get(&departure).map(|airport| LastTrack {
        on_ground: Some(true),
        latitude: Some(airport.position.lat),
        longitude: Some(airport.position.lon),
        altitude: Some(0.0),
        ground_speed: Some(0.0),
        ..Default::default()
    });
    Ok(Pilot {
        callsign: Some(callsign),
        aircraft_id: Some(input.aircraft.trim().to_ascii_uppercase()),
        departure_time: Some(i64::from(minute)),
        last_track: track,
        flight_plan: Some(FlightPlan {
            aircraft_id: Some(input.aircraft.trim().to_ascii_uppercase()),
            departure_id: Some(departure),
            arrival_id: Some(input.arrival.trim().to_ascii_uppercase()),
            date_of_flight: Some(date.format("%Y%m%d").to_string()),
            departure_time: Some(i64::from(minute)),
            level: Some(input.level.trim().to_ascii_uppercase()),
            speed: Some(input.speed.trim().to_ascii_uppercase()),
            route: Some(input.route.trim().to_ascii_uppercase()),
            flight_rules: Some(input.flight_rules.trim().to_ascii_uppercase()),
            ..Default::default()
        }),
        ..Default::default()
    })
}

fn flight_tool_summary(pilot: &Pilot) -> serde_json::Value {
    let plan = pilot.flight_plan.as_ref();
    serde_json::json!({
        "callsign": pilot.callsign, "aircraft": pilot.aircraft_id.as_deref().or_else(|| plan.and_then(|p| p.aircraft_id.as_deref())),
        "departure": plan.and_then(|p| p.departure_id.as_deref()), "arrival": plan.and_then(|p| p.arrival_id.as_deref()),
        "route": plan.and_then(|p| p.route.as_deref()), "level": plan.and_then(|p| p.level.as_deref()),
        "speed": plan.and_then(|p| p.speed.as_deref()), "flightRules": plan.and_then(|p| p.flight_rules.as_deref()),
        "date": plan.and_then(|p| p.date_of_flight.as_deref()), "eobt": pilot_cdm_eobt(pilot).map(|m| format!("{:02}:{:02}", m / 60, m % 60)),
        "onGround": pilot_is_on_ground(pilot)
    })
}

fn local_fpl_checks(
    pilot: &Pilot,
    nav: &Navdata,
    points: &[iatfm_core::dashboard::VerticalProfilePoint],
) -> Vec<serde_json::Value> {
    let mut checks = Vec::new();
    let mut add = |field: &str, status: &str, message: String| {
        checks.push(serde_json::json!({"field":field,"status":status,"message":message}))
    };
    let Some(plan) = &pilot.flight_plan else {
        add("FPL", "error", "No filed flight plan is available.".into());
        return checks;
    };
    for (field, id) in [
        ("Departure", &plan.departure_id),
        ("Arrival", &plan.arrival_id),
    ] {
        let id = id.as_deref().unwrap_or("").trim().to_ascii_uppercase();
        if id.len() != 4 || !id.bytes().all(|b| b.is_ascii_alphanumeric()) {
            add(
                field,
                "error",
                "A four-character airport identifier is required.".into(),
            );
        } else if !nav.airports.contains_key(&id) {
            add(
                field,
                "error",
                format!("{id} is absent from the loaded navigation database."),
            );
        } else {
            add(field, "pass", format!("{id} found in navigation data."));
        }
    }
    let aircraft = pilot
        .aircraft_id
        .as_deref()
        .or(plan.aircraft_id.as_deref())
        .unwrap_or("");
    let valid_aircraft =
        (2..=4).contains(&aircraft.len()) && aircraft.bytes().all(|b| b.is_ascii_alphanumeric());
    add(
        "Aircraft",
        if valid_aircraft { "pass" } else { "error" },
        if valid_aircraft {
            format!("Aircraft type: {aircraft} (syntax only).")
        } else {
            "An aircraft type designator is required.".into()
        },
    );
    let rules = plan
        .flight_rules
        .as_deref()
        .unwrap_or("")
        .to_ascii_uppercase();
    add(
        "Flight rules",
        if ["I", "V", "Y", "Z", "IFR", "VFR"].contains(&rules.as_str()) {
            "pass"
        } else {
            "error"
        },
        format!(
            "Filed rules: {}",
            if rules.is_empty() { "missing" } else { &rules }
        ),
    );
    let level = plan
        .level
        .as_deref()
        .unwrap_or("")
        .trim()
        .to_ascii_uppercase();
    let digits = level
        .strip_prefix("FL")
        .or_else(|| level.strip_prefix('F'))
        .or_else(|| level.strip_prefix('A'))
        .unwrap_or(&level);
    let limit = if level.starts_with('F') || level.starts_with('A') {
        660
    } else {
        66000
    };
    let valid_level = (level == "VFR" && matches!(rules.as_str(), "V" | "VFR"))
        || !digits.is_empty()
            && digits.bytes().all(|c| c.is_ascii_digit())
            && digits.parse::<u32>().is_ok_and(|n| n > 0 && n <= limit);
    add(
        "Level",
        if valid_level { "pass" } else { "error" },
        if valid_level {
            format!("Filed level: {level}")
        } else {
            "Missing or unsupported level; use F350, A050 or feet.".into()
        },
    );
    let speed = plan
        .speed
        .as_deref()
        .unwrap_or("")
        .trim()
        .to_ascii_uppercase();
    let valid_speed = speed.is_ascii()
        && match speed.as_bytes().first() {
            Some(b'N' | b'K') => {
                speed.len() == 5
                    && speed[1..].bytes().all(|b| b.is_ascii_digit())
                    && speed[1..].parse::<u32>().is_ok_and(|n| n > 0 && n <= 3000)
            }
            Some(b'M') => {
                speed.len() == 4
                    && speed[1..].bytes().all(|b| b.is_ascii_digit())
                    && speed[1..].parse::<u32>().is_ok_and(|n| n > 0 && n <= 300)
            }
            _ => false,
        };
    add(
        "Speed",
        if valid_speed { "pass" } else { "error" },
        if valid_speed {
            format!("Filed speed: {speed}")
        } else {
            "Missing or unsupported cruise speed; use N0450, K0830 or M080.".into()
        },
    );
    let route = plan.route.as_deref().unwrap_or("").trim();
    if route.is_empty() {
        add(
            "Route",
            "error",
            "A route is required (DCT for a direct route).".into(),
        );
    }
    let unresolved = points
        .iter()
        .filter(|p| p.position.is_none() || p.minute_offset.is_none() || p.altitude_ft.is_none())
        .map(|p| p.name.as_str())
        .collect::<Vec<_>>();
    if points.len() < 2 {
        add(
            "Trajectory",
            "error",
            "The local trajectory cannot be resolved.".into(),
        );
    } else if !unresolved.is_empty() {
        add(
            "Trajectory",
            "error",
            format!("Unresolved route points: {}", unresolved.join(", ")),
        );
    } else {
        add(
            "Trajectory",
            "pass",
            format!("{} route/profile points resolved locally.", points.len()),
        );
    }
    if pilot_cdm_eobt(pilot).is_none() {
        add(
            "EOBT",
            "error",
            "A valid UTC EOBT is required for a CTOT estimate.".into(),
        );
    }
    add("IFPS", "information", "Local checks only. Equipment/PBN capabilities and item 18/19 semantics are not fully validated. RAD and IVAO coverage are reported separately; this is not official IFPS acceptance.".into());
    checks
}

fn etfms_lateral_geometry(
    points: &[iatfm_core::dashboard::VerticalProfilePoint],
    sectors: &[iatfm_core::models::SectorSource],
    crossed: &[iatfm_core::dashboard::VerticalProfileSector],
) -> serde_json::Value {
    let mut blocks = Vec::new();
    for sector in sectors.iter().filter(|s| s.is_elementary && !s.eurocontrol.ignored_in_geometry) {
        let Some(id) = sector.id.as_deref() else { continue };
        let bands = crossed.iter().filter(|b| b.sector_id == id).collect::<Vec<_>>();
        if bands.is_empty() { continue; }
        for mut block in crate::templates::rad_sector_blocks(sector) {
            let floor = block["floorFt"].as_f64().unwrap_or(0.).max(0.);
            let ceiling = block["ceilingFt"].as_f64();
            if bands.iter().any(|b| b.floor_ft == floor && b.ceiling_ft == ceiling) {
                block["sectorId"] = id.into();
                blocks.push(block);
            }
        }
    }
    let route = points.iter().map(|p| p.position
        .filter(|p| p.lat.is_finite() && p.lon.is_finite())
        .map(|p| [p.lat, p.lon])).collect::<Vec<_>>();
    serde_json::json!({"routePoints":route,"blocks":blocks})
}

impl AppState {
    fn render_etfms_profile(&self, request: &Request) -> Response {
        let id = match searched_callsign(request) {
            Ok(id) => id,
            Err(response) => return response,
        };
        let snapshot = match self.load_whazzup_snapshot() {
            Ok(snapshot) => self.apply_tobt_overrides_to_snapshot(snapshot),
            Err(_) => return Response::service_unavailable("IVAO traffic is unavailable.".into()),
        };
        let Some(pilot) = snapshot.clients.pilots.iter().find(|p| {
            p.callsign
                .as_deref()
                .is_some_and(|c| c.eq_ignore_ascii_case(&id))
        }) else {
            return Response::bad_request("No online IVAO flight matches this callsign.".into());
        };
        let now = Utc::now();
        let reference = self.reference_data_snapshot();
        let tracks = self.load_nat_tracks().unwrap_or_default();
        let routes = route_navdata_with_nat_tracks(&reference.route_navdata, &tracks, now);
        let winds = self.load_metar_winds().unwrap_or_default();
        let weather = self.weather_snapshot(now);
        let points = iatfm_core::dashboard::build_pilot_vertical_profile(
            now,
            pilot,
            &snapshot.clients.atcs,
            &routes,
            &reference.navdata,
            &winds,
            &self.aircraft_performance,
            weather.as_deref(),
        );
        let sectors =
            iatfm_core::dashboard::build_vertical_profile_sectors(&points, &reference.sectors);
        let lateral = etfms_lateral_geometry(&points, &reference.sectors, &sectors);
        Response::json(serde_json::json!({"flight":flight_tool_summary(pilot), "callsign":id,
            "points":points, "sectors":sectors, "lateral":lateral, "route":pilot.flight_plan.as_ref().and_then(|p| p.route.as_deref()),
            "connectedSectors":crate::templates::connected_sector_positions(&reference.sectors,&snapshot.clients.atcs),
            "sampledAt":now, "trafficSampledAt":snapshot.updated_at}).to_string())
    }

    fn check_flight_plan(&self, request: &Request) -> Response {
        let now = Utc::now();
        let reference = self.reference_data_snapshot();
        let manual = request.method == "POST";
        let traffic = self.load_whazzup_snapshot();
        let traffic_available = traffic.is_ok();
        let mut snapshot = traffic
            .map(|s| self.apply_tobt_overrides_to_snapshot(s))
            .unwrap_or_default();
        let pilot = if manual {
            let input = match serde_json::from_slice::<ManualFplInput>(&request.body) {
                Ok(input) => input,
                Err(_) => return Response::bad_request("Expected an ICAO FPL message in the icaoText field, with optional fallback date.".into()),
            };
            match match input {
                ManualFplInput::Icao(input) => icao_fpl_pilot(input, &reference.navdata),
                ManualFplInput::Fields(input) => manual_fpl_pilot(input, &reference.navdata),
            } {
                Ok(pilot) => pilot,
                Err(error) => return Response::bad_request(error),
            }
        } else {
            let id = match searched_callsign(request) {
                Ok(id) => id,
                Err(response) => return response,
            };
            if !traffic_available {
                return Response::service_unavailable("IVAO traffic is unavailable.".into());
            }
            match snapshot.clients.pilots.iter().find(|p| {
                p.callsign
                    .as_deref()
                    .is_some_and(|c| c.eq_ignore_ascii_case(&id))
            }) {
                Some(pilot) => pilot.clone(),
                None => {
                    return Response::bad_request(
                        "No online IVAO flight matches this callsign.".into(),
                    );
                }
            }
        };
        // A manual scenario replaces the same callsign only inside this simulation.
        if manual {
            snapshot.clients.pilots.retain(|p| {
                p.callsign.as_deref().is_none_or(|c| {
                    !c.eq_ignore_ascii_case(pilot.callsign.as_deref().unwrap_or_default())
                })
            });
            snapshot.clients.pilots.push(pilot.clone());
        }
        let tracks = self.load_nat_tracks().unwrap_or_default();
        let routes = route_navdata_with_nat_tracks(&reference.route_navdata, &tracks, now);
        let winds = self.load_metar_winds().unwrap_or_default();
        let weather = self.weather_snapshot(now);
        let points = iatfm_core::dashboard::build_pilot_vertical_profile(
            now,
            &pilot,
            &snapshot.clients.atcs,
            &routes,
            &reference.navdata,
            &winds,
            &self.aircraft_performance,
            weather.as_deref(),
        );
        let mut checks = local_fpl_checks(&pilot, &reference.navdata, &points);
        if manual {
            let plan = pilot.flight_plan.as_ref().unwrap();
            let date = chrono::NaiveDate::parse_from_str(
                plan.date_of_flight.as_deref().unwrap(),
                "%Y%m%d",
            )
            .unwrap();
            let eobt = date.and_hms_opt(0, 0, 0).unwrap().and_utc()
                + ChronoDuration::minutes(i64::from(pilot_cdm_eobt(&pilot).unwrap()));
            if eobt < now - ChronoDuration::minutes(5) || eobt >= now + ChronoDuration::hours(24) {
                checks.push(serde_json::json!({"field":"EOBT", "status":"error", "message":"Manual simulations require an EOBT within the next 24 hours (UTC)."}));
            }
        }
        if reference.traffic_volumes.volumes.is_empty() || self.fmp_regulations_load_error.is_some()
        {
            checks.push(serde_json::json!({"field":"Regulations", "status":"error", "message":"The local regulation catalogue is incomplete or unavailable; CTOT calculation is disabled."}));
        } else if let Some(warning) = &reference.traffic_volumes_load_error {
            checks.push(serde_json::json!({"field":"Catalogue", "status":"warning", "message":format!("{warning}. The provisional estimate may miss matches outside the available coverage.")}));
        }
        let errors = checks.iter().any(|c| c["status"] == "error");
        let warnings = checks.iter().any(|c| c["status"] == "warning");
        let regulations = self.fmp_regulations_snapshot();
        let active = regulations
            .iter()
            .filter(|r| {
                r.enabled && r.end_utc > now && r.start_utc < now + ChronoDuration::hours(24)
            })
            .collect::<Vec<_>>();
        let mut ctot = serde_json::json!({"status":"notRegulated", "message":"No applicable local regulation found.", "provisional":true});
        let mut impact = None;
        if errors {
            ctot = serde_json::json!({"status":"unavailable","message":"Resolve the flight plan errors before estimating a CTOT."});
        } else if !traffic_available {
            ctot = serde_json::json!({"status":"unavailable","message":"Traffic is unavailable; capacity competition cannot be estimated."});
        } else if !pilot_is_on_ground(&pilot) {
            ctot = serde_json::json!({"status":"airborne","message":"Flight is already airborne; no departure CTOT is calculated."});
        } else if pilot
            .flight_plan
            .as_ref()
            .and_then(|p| p.flight_rules.as_deref())
            .is_some_and(|r| r.eq_ignore_ascii_case("V") || r.eq_ignore_ascii_case("VFR"))
        {
            ctot = serde_json::json!({"status":"notApplicable","message":"VFR flight: no IFR CTOT is calculated."});
        } else if !active.is_empty() {
            let previous = self.fmp_forecast_snapshot();
            let mut locks = regulated_ctot_stability_locks(
                &previous.rows,
                Some(&snapshot_default_date_of_flight(&snapshot)),
            );
            let overrides = self.tobt_overrides_snapshot();
            locks.extend(ready_ctot_locks(&overrides));
            if manual {
                locks.retain(|lock| {
                    !lock
                        .callsign
                        .eq_ignore_ascii_case(pilot.callsign.as_deref().unwrap_or_default())
                });
            }
            let exemptions = fmp_ctot_exemptions_for_forecast(&self.fmp_ctot_exemptions_snapshot());
            let activated = fmp_activated_flight_keys_for_snapshot(&overrides, &snapshot);
            let requested = active
                .iter()
                .map(|r| r.volume_id.clone())
                .collect::<BTreeSet<_>>();
            // All traffic competes for capacity; only regulated volumes need output.
            // No cached allocations, pilot overrides or regulations are published here.
            let forecast = iatfm_core::dashboard::build_fmp_traffic_forecast_prepared(
                now,
                &snapshot.clients.atcs,
                &snapshot.clients.pilots,
                &reference.traffic_volumes,
                &routes,
                &regulations,
                &locks,
                &exemptions,
                &activated,
                &reference.navdata,
                &winds,
                &self.aircraft_performance,
                weather.as_deref(),
                &reference.fmp_prepared,
                iatfm_core::dashboard::FmpCalculationOptions {
                    casa: Some(&self.casa_parameters),
                    volume_ids: Some(&requested),
                    compact: true,
                    workers: 0,
                },
            );
            let logs = forecast
                .rows
                .iter()
                .flat_map(|r| &r.volume_aircraft_logs)
                .filter(|log| {
                    pilot
                        .callsign
                        .as_deref()
                        .is_some_and(|id| log.callsign.eq_ignore_ascii_case(id))
                })
                .collect::<Vec<_>>();
            if let Some(allocation) = logs.iter().find_map(|log| log.allocation.as_ref()) {
                ctot = serde_json::json!({"status":if allocation.status == iatfm_core::casa::AllocationStatus::Unallocated {"unallocated"} else {"estimated"},
                    "provisional":true, "takeoffUtc":allocation.takeoff_utc, "delayMinutes":allocation.delay_minutes,
                    "regulationId":allocation.regulation_id,"volumeId":allocation.volume_id,"message":allocation.message});
                if let Some(id) = &allocation.volume_id {
                    impact = crate::templates::render_map_volume_detail(
                        id,
                        &reference.traffic_volumes,
                        &reference.sectors,
                        &reference.traffic_volume_airport_groups,
                        &reference.navdata,
                    )
                    .and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok());
                }
            } else if logs.iter().any(|log| log.ctot_exempt) {
                ctot = serde_json::json!({"status":"exempt","message":"Flight is exempt from the matched local regulations."});
            }
        }
        let takeoff = ctot["takeoffUtc"].as_str().and_then(|s| s.parse::<DateTime<Utc>>().ok()).unwrap_or_else(|| {
            let plan = pilot.flight_plan.as_ref();
            let date = plan.and_then(|p| p.date_of_flight.as_deref()).and_then(|s| chrono::NaiveDate::parse_from_str(s, "%Y%m%d").ok().or_else(|| chrono::NaiveDate::parse_from_str(s, "%y%m%d").ok())).unwrap_or(now.date_naive());
            let eobt = date.and_hms_opt(0,0,0).unwrap().and_utc() + ChronoDuration::minutes(i64::from(pilot_cdm_eobt(&pilot).unwrap_or(0)));
            eobt.max(now) + ChronoDuration::minutes(i64::from(self.casa_parameters.taxi_minutes(plan.and_then(|p|p.departure_id.as_deref()))))
        });
        let (mut rad_checks, mut rad_metadata) = self.check_rad_and_areas(&pilot, &points, &reference, takeoff);
        if ctot["status"] == "unallocated" || !pilot_is_on_ground(&pilot) {
            for check in &mut rad_checks { if check["status"] == "error" { check["status"] = "warning".into(); } }
            rad_metadata["timingConfirmed"] = false.into();
            rad_checks.push(serde_json::json!({"field":"RAD timing","status":"warning","message":"No reliable future departure time is available for this flight; time-dependent conflicts need confirmation."}));
        }
        let rad_errors = rad_checks.iter().any(|c| c["status"] == "error");
        checks.extend(rad_checks);
        let errors = errors || rad_errors;
        let warnings = warnings || checks.iter().any(|c| c["status"] == "warning");
        if rad_errors {
            ctot["routeConformity"] = "conflict".into();
            ctot["message"] = "Provisional calculation only: the route has RAD or special-area conflicts.".into();
        }
        let map_points = points
            .iter()
            .map(|p| p.position.map(|p| [p.lat, p.lon]))
            .collect::<Vec<_>>();
        Response::json(serde_json::json!({"flight":flight_tool_summary(&pilot), "mode":if manual {"manual"} else {"ivao"},
            "validation":{"officialIfps":false,"status":if errors {"errors"} else if warnings {"warnings"} else {"passedLocal"},"checks":checks},
            "ctot":ctot,"impact":impact,"rad":rad_metadata,"routePoints":map_points,"sampledAt":now,"trafficSampledAt":snapshot.updated_at}).to_string())
    }
}
