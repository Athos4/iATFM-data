fn rad_test_point(
    lon: f64,
    altitude: f64,
    minute: u32,
) -> iatfm_core::dashboard::VerticalProfilePoint {
    iatfm_core::dashboard::VerticalProfilePoint {
        name: format!("P{minute}"),
        position: Some(Point { lat: 0.5, lon }),
        altitude_ft: Some(altitude),
        minute_offset: Some(minute),
        distance_nm: None,
    }
}
fn rad_test_area() -> RadValue {
    rad_json!({"id":123,"name":"D-001 TEST","type":"R","minimumAlt":10000,"maximumAlt":20000,"description":"Military area","activationDetails":"Scheduled","centers":[{"id":"EGTT"}],"regionMap":[{"lat":0.,"lng":2.},{"lat":0.,"lng":4.},{"lat":1.,"lng":4.},{"lat":1.,"lng":2.}],"times":[{"startTime":"22:00:00","endTime":"02:00:00","dayMon":true,"dayTue":false,"dayWed":false,"dayThu":false,"dayFri":false,"daySat":false,"daySun":false}]})
}

fn rad_context_for_test<'a>(
    pilot: &'a Pilot,
    points: &'a [iatfm_core::dashboard::VerticalProfilePoint],
    reference: &'a ReferenceData,
    areas: &'a SpecialAreaCache,
) -> RadContext<'a> {
    RadContext {
        support: Arc::new(rad_json!({})),
        support_offsets: Vec::new(),
        rule_key: String::new(),
        rule_id: String::new(),
        pilot,
        points,
        reference,
        areas,
        at: "2026-11-05T12:00:00Z".parse().unwrap(),
        takeoff: "2026-11-05T12:00:00Z".parse().unwrap(),
        groups: BTreeMap::new(),
        aliases: BTreeMap::new(),
        geometry: BTreeMap::new(),
        visits: BTreeMap::new(),
        matches: BTreeMap::new(),
        area_lookup: BTreeMap::new(),
        candidate_lookup: BTreeMap::new(),
        sector_lookup: reference
            .sectors
            .iter()
            .enumerate()
            .filter_map(|(i, s)| Some((s.id.clone()?, i)))
            .collect(),
        procedure_ids: reference
            .navdata
            .procedures
            .values()
            .flatten()
            .map(|p| p.name.clone())
            .collect(),
        unresolved: BTreeSet::new(),
        spans: BTreeMap::new(),
    }
}

#[test]
fn rad_extended_routes_respect_order_alternatives_and_airway_subsegments() {
    let (state, dir, input) = flight_tools_fixture();
    let mut reference = (*state.reference_data_snapshot()).clone();
    let mut nav = (*reference.navdata).clone();
    for (i, id) in ["AAA", "BBB", "CCC", "DDD"].iter().enumerate() {
        nav.points.insert(
            (*id).into(),
            Point {
                lat: 0.5,
                lon: i as f64,
            },
        );
    }
    nav.airways
        .insert("R1".into(), vec!["AAA".into(), "BBB".into(), "CCC".into()]);
    reference.navdata = Arc::new(nav);
    let mut pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    pilot.flight_plan.as_mut().unwrap().route = Some("AAA R1 CCC DCT DDD".into());
    let points = ["AAA", "BBB", "CCC", "DDD"]
        .iter()
        .enumerate()
        .map(|(i, id)| {
            let mut p = rad_test_point(i as f64, 35000., i as u32 * 10);
            p.name = (*id).into();
            p
        })
        .collect::<Vec<_>>();
    let areas = SpecialAreaCache::default();
    let mut ctx = rad_context_for_test(&pilot, &points, &reference, &areas);
    assert_eq!(ctx.eval(&rad_json!({"op":"ordered","args":[{"op":"via","values":["AAA"]},{"op":"via","values":["CCC"]}]})),RadTruth::Yes);
    assert_eq!(ctx.eval(&rad_json!({"op":"ordered","args":[{"op":"via","values":["CCC"]},{"op":"via","values":["AAA"]}]})),RadTruth::No);
    assert_eq!(
        ctx.eval(&rad_json!({"op":"route","parts":[["AAA"],["R1"],["BBB"]]})),
        RadTruth::Yes
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"route","parts":[["AAA"],["DCT","R1"],["CCC"],["DCT"],["*"]]})),
        RadTruth::Yes
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"route","parts":[["AAA"],["DCT"],["CCC"]]})),
        RadTruth::No
    );
    ctx.at = ctx.takeoff + ChronoDuration::minutes(5);
    assert_eq!(
        ctx.eval(&rad_json!({"op":"routeAtTime","kind":"direct"})),
        RadTruth::No
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"routeAtTime","kind":"named","values":["R1"]})),
        RadTruth::Yes
    );
    ctx.at = ctx.takeoff + ChronoDuration::minutes(25);
    assert_eq!(
        ctx.eval(&rad_json!({"op":"routeAtTime","kind":"direct"})),
        RadTruth::Yes
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"routeAtTime","kind":"airway"})),
        RadTruth::No
    );
    fs::remove_dir_all(dir).unwrap();
}

#[test]
fn rad_boundary_crossings_are_directional_and_same_level_airblocks_are_merged() {
    let (state, dir, input) = flight_tools_fixture();
    let mut reference = (*state.reference_data_snapshot()).clone();
    let block = |left, right| rad_json!({"floorFt":10000,"ceilingFt":20000,"polygon":[{"lat":0.,"lon":left},{"lat":0.,"lon":right},{"lat":1.,"lon":right},{"lat":1.,"lon":left}]});
    reference.sectors=serde_json::from_value(rad_json!([{"id":"AREA_A","blocks":[block(0.,0.5),block(0.5,1.)]},{"id":"AREA_B","blocks":[block(1.,2.)]},{"id":"AREA_C","blocks":[block(2.5,3.)]}])).unwrap();
    let pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    let points = [
        rad_test_point(-1., 15000., 0),
        rad_test_point(4., 15000., 50),
    ];
    let areas = SpecialAreaCache::default();
    let mut ctx = rad_context_for_test(&pilot, &points, &reference, &areas);
    let boundary = |a, b, bidi| rad_json!({"op":"boundary","from":{"op":"via","values":[a]},"to":{"op":"via","values":[b]},"bidirectional":bidi});
    assert_eq!(
        ctx.eval(&boundary("AREA_A", "AREA_B", false)),
        RadTruth::Yes
    );
    assert_eq!(ctx.eval(&boundary("AREA_B", "AREA_A", false)), RadTruth::No);
    assert_eq!(ctx.eval(&boundary("AREA_B", "AREA_A", true)), RadTruth::Yes);
    assert_eq!(ctx.eval(&boundary("AREA_A", "AREA_C", false)), RadTruth::No);
    let geometry = ctx.rule_geometry(&rad_json!({"id":"TEST","refs":["AREA_A"]}));
    assert_eq!(geometry["blocks"].as_array().unwrap().len(), 1);
    assert_eq!(
        geometry["blocks"][0]["mergedPolygons"]
            .as_array()
            .unwrap()
            .len(),
        1
    );
    let unknown = ctx.eval(&boundary("AREA_A", "MISSING", false));
    assert_eq!(unknown, RadTruth::Unknown);
    fs::remove_dir_all(dir).unwrap();
}

#[test]
fn rad_extended_schedules_handle_seasons_overnight_days_and_indexed_exceptions() {
    let (state, dir, input) = flight_tools_fixture();
    let reference = state.reference_data_snapshot();
    let pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    let areas = SpecialAreaCache::default();
    let mut ctx = rad_context_for_test(&pilot, &[], &reference, &areas);
    let time =
        rad_json!({"op":"weekSchedule","days":[0],"schedule":{"op":"time","start":1320,"end":120}});
    ctx.at = "2026-11-03T01:59:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&time), RadTruth::Yes);
    ctx.at = "2026-11-03T02:00:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&time), RadTruth::No);
    ctx.at = "2026-03-29T00:59:00Z".parse().unwrap();
    assert_eq!(
        ctx.eval(&rad_json!({"op":"season","value":"SUMMER"})),
        RadTruth::No
    );
    ctx.at = "2026-03-29T01:00:00Z".parse().unwrap();
    assert_eq!(
        ctx.eval(&rad_json!({"op":"season","value":"SUMMER"})),
        RadTruth::Yes
    );
    ctx.at = "2026-10-25T01:00:00Z".parse().unwrap();
    assert_eq!(
        ctx.eval(&rad_json!({"op":"season","value":"SUMMER"})),
        RadTruth::No
    );
    let exception = rad_json!({"op":"not","args":[{"op":"scheduled","condition":{"op":"true"},"schedule":{"op":"time","start":1320,"end":300}}]});
    ctx.at = "2026-11-05T04:00:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&exception), RadTruth::No);
    ctx.at = "2026-11-05T12:00:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&exception), RadTruth::Yes);
    let period = rad_json!({"op":"airacPeriod","startMonth":3,"endMonth":10,"endLast":false});
    ctx.at = "2026-10-28T12:00:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&period), RadTruth::Yes);
    ctx.at = "2026-10-29T12:00:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&period), RadTruth::No);
    fs::remove_dir_all(dir).unwrap();
}

