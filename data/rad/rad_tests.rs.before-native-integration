#[test]
fn rad_levels_inside_airspaces_detect_intermediate_changes_and_threshold_crossings() {
    let (state, dir, input) = flight_tools_fixture();
    let mut reference = (*state.reference_data_snapshot()).clone();
    reference.sectors = serde_json::from_value(rad_json!([{"id":"AREA","blocks":[{"floorFt":0,"ceilingFt":60000,"polygon":[{"lat":0.,"lon":0.},{"lat":0.,"lon":3.},{"lat":1.,"lon":3.},{"lat":1.,"lon":0.}]}]}])).unwrap();
    let mut pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    pilot.flight_plan.as_mut().unwrap().route =
        Some("AAA DCT BBB/N0450F200 DCT CCC/N0450F350 DCT DDD".into());
    let points = ["START", "AAA", "BBB", "CCC", "DDD", "END"]
        .iter()
        .enumerate()
        .map(|(i, id)| {
            let mut p = rad_test_point(
                i as f64 - 1.,
                if i == 2 { 15000. } else { 35000. },
                i as u32 * 10,
            );
            p.name = (*id).into();
            p
        })
        .collect::<Vec<_>>();
    let areas = SpecialAreaCache::default();
    let mut ctx = rad_context_for_test(&pilot, &points, &reference, &areas);
    let mut level = rad_json!({"op":"level","comparison":"BLW","value":23000,"location":{"op":"via","values":["AREA"]},"locationType":"IN"});
    let (events, unknown) = ctx.events(&level);
    assert!(!unknown);
    assert_eq!(events.len(), 1);
    assert!((events[0].0 - 16.).abs() < 1e-6);
    assert!((events[0].1 - 24.).abs() < 1e-6);
    level["comparison"] = "FL".into();
    level["value"] = 20000.into();
    let (events, unknown) = ctx.events(&level);
    assert!(!unknown);
    assert_eq!(events.len(), 2);
    assert!(events[0].0 < 17.5 && events[0].1 > 17.5);
    assert!(events[1].0 < 22.5 && events[1].1 > 22.5);
    level["requested"] = true.into();
    let (events, unknown) = ctx.events(&level);
    assert!(!unknown);
    assert_eq!(events.len(), 1);
    assert_eq!(events[0].0, 20.);
    assert!(events[0].1 < 30. && events[0].1 > 29.999);
    // Requested levels jump from FL350 to FL200 and back: they never satisfy
    // this band, even though separate lower/upper tests would each succeed.
    level["comparison"] = "BTN".into();
    level["value"] = 22000.into();
    level["upper"] = 30000.into();
    assert_eq!(ctx.eval(&level), RadTruth::No);
    level["requested"] = false.into();
    assert_eq!(ctx.eval(&level), RadTruth::Yes);
    fs::remove_dir_all(dir).unwrap();
}

#[test]
fn rad_area_geometry_detects_between_points_and_vertical_crossings_without_gaps() {
    let area = parse_special_areas(&rad_json!([rad_test_area()]))
        .unwrap()
        .remove(0);
    let points = [
        rad_test_point(0., 15000., 0),
        rad_test_point(6., 15000., 60),
    ];
    let spans = rad_crossings(&points, &area.polygon, 10000., 20000.);
    assert_eq!(spans.len(), 1);
    assert!((spans[0].0 - 20.).abs() < 1e-6);
    assert!((spans[0].1 - 40.).abs() < 1e-6);
    assert!(rad_crossings(&points, &area.polygon, 25000., 30000.).is_empty());
    let climbing = [rad_test_point(0., 0., 0), rad_test_point(6., 30000., 60)];
    assert_eq!(
        rad_crossings(&climbing, &area.polygon, 15000., 20000.),
        vec![(30., 40.)]
    );
    let mut missing = rad_test_point(3., 15000., 30);
    missing.position = None;
    assert!(
        rad_crossings(
            &[
                rad_test_point(0., 15000., 0),
                missing,
                rad_test_point(6., 15000., 60)
            ],
            &area.polygon,
            0.,
            30000.
        )
        .is_empty()
    );
}

