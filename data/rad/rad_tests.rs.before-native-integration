#[test]
fn rad_local_context_preserves_zone_geometry_activation_provenance_and_expiry() {
    let (state, dir, input) = flight_tools_fixture();
    let reference = state.reference_data_snapshot();
    let pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    let mut raw = rad_test_area();
    raw["activationDetails"] = "H24".into();
    let original = SpecialAreaCache {
        areas: Arc::new(parse_special_areas(&rad_json!([raw])).unwrap()),
        fetched_at: Some(Utc::now()),
        error: None,
    };
    let support = rad_json!({"schema":"iatfm-rad-context/1","source":"Verified test fixture","validFrom":"2026-11-05T00:00:00Z","validUntil":"2026-11-06T00:00:00Z",
      "zones":[{"id":"TEST_BUFFER","radIds":["EGD1Z"],"ivaoId":"123","relation":"activationOnly","geometry":{"altitudeReference":"MSL","floorFt":12000,"ceilingFt":18000,"polygon":[{"lat":0.,"lon":1.},{"lat":0.,"lon":5.},{"lat":1.,"lon":5.},{"lat":1.,"lon":1.}]}}]});
    let cache = rad_support_areas(&original, &support).unwrap();
    assert_eq!(cache.areas.len(), 2);
    assert_eq!(cache.areas[1].bounds, [1., 0., 5., 1.]);
    assert_eq!(cache.areas[1].floor, Some(12000.));
    assert_eq!(cache.areas[0].bounds, [2., 0., 4., 1.]);
    assert!(cache.areas[1].names.contains("EGD1Z"));
    let mut ctx = rad_context_for_test(&pilot, &[], &reference, &cache);
    let at = "2026-11-05T12:00:00Z".parse().unwrap();
    assert_eq!(ctx.area_active(1, at), RadTruth::Yes);
    assert_eq!(
        ctx.area_active(1, "2026-11-06T00:00:00Z".parse().unwrap()),
        RadTruth::Unknown
    );
    let mut stale = cache.clone();
    stale.fetched_at = Some(Utc::now() - ChronoDuration::minutes(11));
    let mut ctx = rad_context_for_test(&pilot, &[], &reference, &stale);
    assert_eq!(ctx.area_active(1, at), RadTruth::Unknown);
    let mut invalid = support.clone();
    invalid["zones"][0]["activation"] = rad_json!({"op":"true"});
    assert!(rad_support_areas(&original, &invalid).is_err());
    write_data_file(&dir, "rad/local-context.json", &support.to_string());
    assert!(state.rad_support().is_ok());
    fs::remove_dir_all(dir).unwrap();
}

#[test]
fn rad_external_facts_calendars_and_flight_attributes_require_matching_context() {
    let (state, dir, input) = flight_tools_fixture();
    let reference = state.reference_data_snapshot();
    let pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    let areas = SpecialAreaCache::default();
    let mut ctx = rad_context_for_test(&pilot, &[], &reference, &areas);
    let mut support = rad_json!({"schema":"iatfm-rad-context/1","source":"Verified test fixture","validFrom":"2026-11-05T00:00:00Z","validUntil":"2026-11-06T00:00:00Z",
      "facts":{"Annex 2A:2|DYNAMIC":[{"validFrom":"2026-11-05T11:00:00Z","validUntil":"2026-11-05T13:00:00Z","value":false}]},
      "holidays":{"LF":{"validFrom":"2026-11-05T00:00:00Z","validUntil":"2026-11-06T00:00:00Z","dates":["2026-11-05"]}},"aircraft":{"A320":{"engineType":"J"}},"flights":{}});
    let plan = pilot.flight_plan.as_ref().unwrap();
    support["flights"][pilot.callsign.as_deref().unwrap()] = rad_json!({"departure":plan.departure_id,"arrival":plan.arrival_id,"route":plan.route,"purposes":["CALIBRATION"]});
    ctx.support = Arc::new(support);
    ctx.rule_key = "Annex 2A:2".into();
    ctx.rule_id = "LFTEST".into();
    assert_eq!(
        ctx.eval(&rad_json!({"op":"unknown","reason":"externalSchedule","text":"DYNAMIC"})),
        RadTruth::No
    );
    ctx.rule_key = "Annex 2A:3".into();
    assert_eq!(
        ctx.eval(&rad_json!({"op":"unknown","reason":"externalSchedule","text":"DYNAMIC"})),
        RadTruth::Unknown
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"holiday","calendar":""})),
        RadTruth::Yes
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"flightPurpose","values":["CALIBRATION"]})),
        RadTruth::Yes
    );
    assert_eq!(
        ctx.eval(&rad_json!({"op":"engineType","values":["J"]})),
        RadTruth::Yes
    );
    let windows = rad_json!({"op":"activationWindows","windows":[{"validFrom":"2026-11-05T12:00:00Z","validUntil":"2026-11-05T12:30:00Z","value":true}]});
    assert_eq!(ctx.eval(&windows), RadTruth::Yes);
    ctx.at = "2026-11-05T12:30:00Z".parse().unwrap();
    assert_eq!(ctx.eval(&windows), RadTruth::Unknown);
    ctx.at = "2026-11-06T00:00:00Z".parse().unwrap();
    assert_eq!(
        ctx.eval(&rad_json!({"op":"holiday","calendar":"LF"})),
        RadTruth::Unknown
    );
    assert!(!rad_support_schedule_safe(
        &rad_json!({"op":"active","values":["SELF"]}),
        0
    ));
    fs::remove_dir_all(dir).unwrap();
}

