#[test]
fn rad_suspensions_deletions_and_reactivation_override_older_active_rows() {
    let (state, dir, input) = flight_tools_fixture();
    let reference = state.reference_data_snapshot();
    let pilot =
        manual_fpl_pilot(serde_json::from_value(input).unwrap(), &reference.navdata).unwrap();
    let base = rad_json!({"id":"LIFECYCLE","key":"2B:1","sheet":"Annex 2B","row":1,"validFrom":"2026-10-29","scope":{"op":"true"},"schedule":{"op":"true"},"clauses":[{"action":"forbidden","condition":{"op":"true"}}]});
    let mut suspension = base.clone();
    suspension["change"] = "SUS".into();
    suspension["validFrom"] = "2026-11-05".into();
    suspension["validUntil"] = "2026-11-10".into();
    let mut resumed = base.clone();
    resumed["change"] = "UNS".into();
    resumed["validFrom"] = "2026-11-11".into();
    let mut deleted = base.clone();
    deleted["change"] = "DEL".into();
    deleted["validFrom"] = "2026-11-20".into();
    install_rad_test_catalogue(
        &state,
        &dir,
        rad_json!([deleted, base, resumed, suspension]),
    );
    for (day, violates) in [(3, true), (6, false), (12, true), (21, false)] {
        let at = format!("2026-11-{day:02}T12:00:00Z").parse().unwrap();
        let (checks, meta) = state.check_rad_and_areas(&pilot, &[], &reference, at);
        assert_eq!(
            checks
                .iter()
                .any(|c| c["ruleId"] == "LIFECYCLE" && c["status"] == "error"),
            violates
        );
        if !violates {
            assert_eq!(meta["inactiveRules"], 1);
        }
    }
    fs::remove_dir_all(dir).unwrap();
}

