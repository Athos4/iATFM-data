        rad_json!([{"key":"2C:1","id":"EGD1R","sheet":"Annex 2C","row":1,"areas":["EGD001"],"refs":["EGD001"],"scope":{"op":"via","values":["EGD001"]},"schedule":{"op":"active","values":["EGD001"]},"clauses":[{"action":"forbidden","condition":{"op":"true"}}]}]),
