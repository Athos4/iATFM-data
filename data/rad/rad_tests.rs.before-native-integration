        rad_test_point(6., 15000., 60),
    ];
    let early = "2026-11-02T20:00:00Z".parse().unwrap();
    let late = "2026-11-02T21:45:00Z".parse().unwrap();
    let (checks, _) =
        state.check_rad_and_areas(&pilot, &points, &state.reference_data_snapshot(), early);
    assert!(!checks.iter().any(|c| c["status"] == "error"), "{checks:?}");
    let (checks, meta) =
