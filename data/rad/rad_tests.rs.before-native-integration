    fs::remove_dir_all(dir).unwrap();
}

#[test]
#[ignore = "Installed RAD/IVAO integration and performance audit"]
fn benchmark_rad_installed_catalogue() {
    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
    let state = AppState::load(&root).unwrap();
    let reference = state.reference_data_snapshot();
    let takeoff: DateTime<Utc> = "2026-11-05T12:00:00Z".parse().unwrap();
    let pilot = manual_fpl_pilot(
        ManualFpl {
            callsign: "RADTEST".into(),
            aircraft: "A320".into(),
            departure: "LFPG".into(),
            arrival: "LFBO".into(),
            date: "2026-11-05".into(),
            eobt: "12:00".into(),
            level: "F350".into(),
            speed: "N0450".into(),
            route: "DCT AGN DCT".into(),
            flight_rules: "I".into(),
        },
        &reference.navdata,
    )
    .unwrap();
    let points = iatfm_core::dashboard::build_pilot_vertical_profile(
        takeoff,
        &pilot,
        &[],
        &reference.route_navdata,
        &reference.navdata,
        &BTreeMap::new(),
        &state.aircraft_performance,
        None,
    );
    let start = Instant::now();
    let (checks, meta) = state.check_rad_and_areas(&pilot, &points, &reference, takeoff);
    let cold = start.elapsed().as_millis();
    let start = Instant::now();
    let _ = state.check_rad_and_areas(&pilot, &points, &reference, takeoff);
    let warm = start.elapsed().as_millis();
    eprintln!(
        "RAD cold={cold}ms warm={warm}ms checks={} evaluated={} incomplete={}",
        checks.len(),
        meta["evaluatedRules"],
        meta["incompleteRules"]
    );
    let out = root.parent().unwrap().join("artifacts/rad-inspection");
    fs::create_dir_all(&out).unwrap();
    fs::write(
        out.join("audit.json"),
        rad_json!({"coldMs":cold,"warmMs":warm,"checks":checks,"metadata":meta}).to_string(),
